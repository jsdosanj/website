---
// "The Trajectory" — the five-chapter origin story in src/data/journey.ts
// was authored but never rendered anywhere on the site. This is the UI for
// it: a scroll-drawn trail down the About page, one turn-revealed card per
// chapter. GSAP scrubs the trail's fill in Motion.astro (data-trail-fill);
// with no JS or prefers-reduced-motion, the trail simply shows fully drawn
// and every chapter is visible via Base.astro's global .turn/.reveal
// no-script fallback — nothing ever strands.
import { journey } from '../data/journey';
---
<div class="relative" data-journey-trail>
  <div class="absolute left-[15px] top-2 bottom-2 w-px overflow-hidden" aria-hidden="true">
    <div class="trail-line h-full w-full" data-trail-fill></div>
  </div>
  <ol class="space-y-8 sm:space-y-10 list-none">
    {journey.map((chapter) => (
      <li class="turn relative pl-12">
        <span class="trail-node absolute left-0 top-1 grid place-items-center h-[31px] w-[31px] rounded-full bg-paper-300 border border-kesari-500/40 type-mono-sm text-kesari-700" aria-hidden="true">
          {chapter.chapter}
        </span>
        <div class="card card-hover border-glow p-6 sm:p-6">
          <div class="flex flex-wrap items-center gap-2.5 mb-2.5">
            <span class="type-label text-kesari-700 border border-kesari-500/25 rounded-full px-2.5 py-1">{chapter.marker}</span>
            <span class="type-mono-sm text-ink-500">{chapter.era}</span>
          </div>
          <h3 class="type-title-4 text-navy-900">{chapter.title}</h3>
          <p class="mt-3 type-subhead text-ink-600">{chapter.text}</p>
        </div>
      </li>
    ))}
  </ol>
</div>
