---
// Subtle "digital rain" backdrop. Faint kesari-gold bits fall over graphite;
// a few columns quietly stream the binary of "JASVANT". Performance-minded:
// capped DPR, throttled frame rate, pauses off-screen, static on reduced-motion.
interface Props { class?: string; opacity?: number; }
const { class: className = '', opacity = 0.5 } = Astro.props;
---
<canvas class:list={['binary-rain', className]} data-binary aria-hidden="true" style={`opacity:${opacity}`}></canvas>

<script>
  function initBinary() {
    document.querySelectorAll<HTMLCanvasElement>('[data-binary]').forEach((cv) => {
      if ((cv as any)._wired) return;
      (cv as any)._wired = true;
      const ctx = cv.getContext('2d');
      if (!ctx) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // binary of "JASVANT" (ASCII), streamed down the "name" columns
      const NAME = 'JASVANT'.split('').map((c) => c.charCodeAt(0).toString(2).padStart(8, '0')).join('');
      const FONT = 13, STEP = FONT + 4;
      let w = 0, h = 0, cols = 0, drops: number[] = [], named: boolean[] = [], raf = 0, last = 0, visible = true;

      const resize = () => {
        const p = cv.parentElement;
        if (!p) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        w = p.clientWidth; h = p.clientHeight;
        cv.width = Math.floor(w * dpr); cv.height = Math.floor(h * dpr);
        cv.style.width = w + 'px'; cv.style.height = h + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        cols = Math.ceil(w / STEP);
        drops = Array.from({ length: cols }, () => Math.floor(Math.random() * -40));
        named = Array.from({ length: cols }, (_, i) => i % 7 === 3); // sparse "name" columns
      };

      const draw = (t: number) => {
        raf = visible ? requestAnimationFrame(draw) : 0;
        if (t - last < 70) return; // ~14fps is plenty for rain
        last = t;
        ctx.fillStyle = 'rgba(7,8,10,0.30)';
        ctx.fillRect(0, 0, w, h);
        ctx.font = `${FONT}px "JetBrains Mono", monospace`;
        for (let i = 0; i < cols; i++) {
          const x = i * STEP;
          const y = drops[i] * STEP;
          const ch = named[i] ? NAME[(drops[i] % NAME.length + NAME.length) % NAME.length] : (Math.random() < 0.5 ? '0' : '1');
          // brightest at the head, fading tail handled by the translucent fill
          ctx.fillStyle = named[i] ? 'rgba(247,194,90,0.55)' : 'rgba(240,169,60,0.30)';
          if (y > 0 && y < h) ctx.fillText(ch, x, y);
          if (y > h && Math.random() > 0.975) drops[i] = Math.floor(Math.random() * -20);
          drops[i]++;
        }
      };

      resize();
      window.addEventListener('resize', resize, { passive: true });

      if (reduce) {
        // single faint static frame
        ctx.font = `${FONT}px "JetBrains Mono", monospace`;
        ctx.fillStyle = 'rgba(240,169,60,0.18)';
        for (let i = 0; i < cols; i++)
          for (let j = 0; j < Math.ceil(h / STEP); j += 2)
            ctx.fillText(Math.random() < 0.5 ? '0' : '1', i * STEP, j * STEP + FONT);
        return;
      }

      if ('IntersectionObserver' in window) {
        new IntersectionObserver((e) => {
          visible = e[0].isIntersecting;
          if (visible && !raf) raf = requestAnimationFrame(draw);
        }, { rootMargin: '60px' }).observe(cv);
      }
      raf = requestAnimationFrame(draw);
      document.addEventListener('astro:before-swap', () => { cancelAnimationFrame(raf); visible = false; }, { once: true });
    });
  }

  initBinary();
  document.addEventListener('astro:page-load', initBinary);
</script>
