---
// Standard Dosanjh Labs brand lockup: emblem + wordmark.
// Used in the nav and footer so branding is identical everywhere.
import Khanda from './Khanda.astro';
interface Props {
  class?: string;
  emblemSize?: number;
  showText?: boolean;
  textClass?: string;
}
const { class: className = '', emblemSize = 30, showText = true, textClass = 'text-[15px]' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2.5', className]}>
  <Khanda size={emblemSize} class="text-kesari-400 shrink-0" strokeWidth={2.4} />
  {showText && (
    <span class:list={['font-display font-semibold tracking-tight text-mist-100 leading-none', textClass]}>
      Dosanjh<span class="text-kesari-400"> Labs</span>
    </span>
  )}
</span>
