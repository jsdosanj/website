---
import { nav, site } from '../data/site';
import { url } from '../utils';
import Logo from './Logo.astro';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = url(href).replace(/\/$/, '') || '/';
  return target === current || (href !== '/' && current.startsWith(target));
};
---
<header class="fixed top-0 inset-x-0 z-50">
  <nav class="container-x mt-4" aria-label="Main navigation">
    <div class="glass rounded-2xl pl-3 pr-2.5 sm:pl-4 py-2 flex items-center justify-between shadow-[0_8px_40px_-12px_rgba(0,0,0,0.7)]">
      <!-- Brand + traffic lights -->
      <a href={url('/')} class="group flex items-center min-h-11 gap-3 min-w-0 btn-press" aria-label="Jasvant Dosanjh — home">
        <Logo emblemSize={28} class="gap-2" />
      </a>

      <!-- Desktop links -->
      <ul class="hidden md:flex items-center gap-0.5" role="list">
        {nav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class:list={['inline-flex items-center min-h-11 px-3 rounded-lg type-subhead font-medium tracking-tight transition-colors btn-press', isActive(item.href) ? 'text-navy-900 bg-navy-900/[0.06]' : 'text-ink-600 hover:text-navy-900 hover:bg-navy-900/[0.035]',]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA + mobile toggle -->
      <div class="flex items-center gap-2 shrink-0">
        <a
          href={url('/resume')}
          class="hidden lg:inline-flex items-center min-h-11 gap-1.5 rounded-lg border border-navy-800/14 px-4 type-footnote font-medium text-ink-600 hover:text-navy-900 hover:border-navy-800/28 transition-colors btn-press"
        >
          Résumé
        </a>
        <a
          href={url('/contact')}
          data-magnetic="0.25"
          class="hidden sm:inline-flex items-center min-h-11 gap-2 rounded-lg bg-kesari-500 text-navy-950 px-4 type-footnote font-semibold hover:bg-kesari-400 transition-colors btn-press"
        >
          Let’s talk
        </a>
        <button
          id="nav-toggle"
          class="md:hidden grid place-items-center h-11 w-11 rounded-lg text-ink-800 hover:bg-navy-900/5 transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="7" x2="21" y2="7" class="burger-bar burger-top" />
            <line x1="3" y1="12" x2="21" y2="12" class="burger-bar burger-mid" />
            <line x1="3" y1="17" x2="21" y2="17" class="burger-bar burger-bottom" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden mobile-menu mt-2 glass rounded-2xl p-2" inert>
      <ul class="flex flex-col" role="list">
        {nav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class:list={['flex items-center min-h-11 px-4 rounded-lg type-subhead font-medium transition-colors btn-press', isActive(item.href) ? 'text-navy-900 bg-navy-900/[0.06]' : 'text-ink-700 hover:bg-navy-900/5',]}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="p-2">
          <a href={url('/contact')} class="flex items-center justify-center min-h-11 rounded-lg bg-kesari-500 text-navy-950 px-4 font-semibold btn-press">Let’s talk</a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  function wireNav() {
    const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    const setOpen = (open: boolean) => {
      menu.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('inert', !open);
    };

    const onToggleClick = () => setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    const onLinkClick = () => setOpen(false);
    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    };
    const onDocClick = (e: MouseEvent) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      const target = e.target as Node;
      if (!menu.contains(target) && !toggle.contains(target)) setOpen(false);
    };

    toggle.addEventListener('click', onToggleClick);
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', onLinkClick));
    document.addEventListener('keydown', onKeydown);
    document.addEventListener('click', onDocClick);

    // document persists across swaps — remove these before the next page's
    // wireNav() adds its own, or they'd stack up (same class of leak as the
    // custom cursor's pointerover/pointerout listeners).
    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('keydown', onKeydown);
      document.removeEventListener('click', onDocClick);
    }, { once: true });
  }
  wireNav();
  document.addEventListener('astro:after-swap', wireNav);
</script>

<style>
  .mobile-menu {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: max-height 0.35s var(--ease-out-expo), opacity 0.25s ease, transform 0.3s var(--ease-out-expo);
  }
  .mobile-menu.is-open {
    max-height: 28rem;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .burger-bar {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.3s var(--ease-out-expo), opacity 0.2s ease;
  }
  #nav-toggle[aria-expanded='true'] .burger-top { transform: translateY(5px) rotate(45deg); }
  #nav-toggle[aria-expanded='true'] .burger-mid { opacity: 0; transform: scaleX(0); }
  #nav-toggle[aria-expanded='true'] .burger-bottom { transform: translateY(-5px) rotate(-45deg); }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu, .burger-bar { transition: none; }
  }
</style>
