---
import { nav, site } from '../data/site';
import { url } from '../utils';
import Logo from './Logo.astro';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = url(href).replace(/\/$/, '') || '/';
  return target === current || (href !== '/' && current.startsWith(target));
};
---
<header class="fixed top-0 inset-x-0 z-50">
  <nav class="container-x mt-4" aria-label="Main navigation">
    <div class="glass rounded-2xl pl-3 pr-2.5 sm:pl-4 py-2 flex items-center justify-between shadow-[0_8px_40px_-12px_rgba(0,0,0,0.7)]">
      <!-- Brand + traffic lights -->
      <a href={url('/')} class="group flex items-center gap-3 shrink-0" aria-label="Jasvant Dosanjh — home">
        <span class="term-lights hidden sm:flex" aria-hidden="true">
          <span class="term-light red"></span>
          <span class="term-light amber"></span>
          <span class="term-light green"></span>
        </span>
        <Logo emblemSize={28} class="gap-2" />
      </a>

      <!-- Desktop links -->
      <ul class="hidden md:flex items-center gap-0.5" role="list">
        {nav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class:list={[
                'mono px-3 py-2 rounded-lg text-[13px] tracking-tight transition-colors',
                isActive(item.href)
                  ? 'text-kesari-300 bg-white/[0.05]'
                  : 'text-mist-400 hover:text-mist-100 hover:bg-white/[0.03]',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="text-mist-600">/</span>{item.label.toLowerCase()}
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA + mobile toggle -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="cmdk-hint"
          class="hidden lg:inline-flex items-center gap-1.5 rounded-lg border border-white/10 px-2.5 py-1.5 text-mist-500 hover:text-kesari-300 hover:border-kesari-500/30 transition-colors"
          aria-label="Open command palette"
        >
          <kbd class="kbd">⌘K</kbd>
        </button>
        <a
          href={url('/contact')}
          data-magnetic="0.25"
          class="hidden sm:inline-flex items-center gap-2 rounded-lg bg-kesari-500 text-ink-950 px-4 py-2 text-[13px] font-semibold mono hover:bg-kesari-400 transition-colors"
        >
          ./hire-me
        </a>
        <button
          id="nav-toggle"
          class="md:hidden grid place-items-center h-10 w-10 rounded-lg text-mist-200 hover:bg-white/5 transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="7" x2="21" y2="7" class="burger-bar burger-top" />
            <line x1="3" y1="12" x2="21" y2="12" class="burger-bar burger-mid" />
            <line x1="3" y1="17" x2="21" y2="17" class="burger-bar burger-bottom" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden mobile-menu mt-2 glass rounded-2xl p-2" inert>
      <ul class="flex flex-col" role="list">
        {nav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class:list={[
                'mono block px-4 py-3 rounded-lg text-[15px] transition-colors',
                isActive(item.href) ? 'text-kesari-300 bg-white/[0.05]' : 'text-mist-300 hover:bg-white/5',
              ]}
            >
              <span class="text-mist-600">/</span>{item.label.toLowerCase()}
            </a>
          </li>
        ))}
        <li class="p-2">
          <a href={url('/contact')} class="mono block text-center rounded-lg bg-kesari-500 text-ink-950 px-4 py-3 font-semibold">./hire-me</a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  function wireNav() {
    const cmdkHint = document.getElementById('cmdk-hint');
    cmdkHint?.addEventListener('click', () => document.dispatchEvent(new CustomEvent('cmdk:open')));

    const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    const setOpen = (open: boolean) => {
      menu.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('inert', !open);
    };

    const onToggleClick = () => setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    const onLinkClick = () => setOpen(false);
    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    };
    const onDocClick = (e: MouseEvent) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      const target = e.target as Node;
      if (!menu.contains(target) && !toggle.contains(target)) setOpen(false);
    };

    toggle.addEventListener('click', onToggleClick);
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', onLinkClick));
    document.addEventListener('keydown', onKeydown);
    document.addEventListener('click', onDocClick);

    // document persists across swaps — remove these before the next page's
    // wireNav() adds its own, or they'd stack up (same class of leak as the
    // custom cursor's pointerover/pointerout listeners).
    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('keydown', onKeydown);
      document.removeEventListener('click', onDocClick);
    }, { once: true });
  }
  wireNav();
  document.addEventListener('astro:after-swap', wireNav);
</script>

<style>
  .mobile-menu {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: max-height 0.35s var(--ease-out-expo), opacity 0.25s ease, transform 0.3s var(--ease-out-expo);
  }
  .mobile-menu.is-open {
    max-height: 28rem;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .burger-bar {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.3s var(--ease-out-expo), opacity 0.2s ease;
  }
  #nav-toggle[aria-expanded='true'] .burger-top { transform: translateY(5px) rotate(45deg); }
  #nav-toggle[aria-expanded='true'] .burger-mid { opacity: 0; transform: scaleX(0); }
  #nav-toggle[aria-expanded='true'] .burger-bottom { transform: translateY(-5px) rotate(-45deg); }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu, .burger-bar { transition: none; }
  }
</style>
