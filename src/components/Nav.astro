---
import { nav, site } from '../data/site';
import { url } from '../utils';
import Logo from './Logo.astro';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = url(href).replace(/\/$/, '') || '/';
  return target === current || (href !== '/' && current.startsWith(target));
};
---
<header class="fixed top-0 inset-x-0 z-50">
  <nav class="container-x mt-4" aria-label="Main navigation">
    <div class="glass rounded-2xl px-4 sm:px-5 py-2.5 flex items-center justify-between shadow-[0_8px_40px_-12px_rgba(0,0,0,0.6)]">
      <!-- Brand -->
      <a href={url('/')} class="group flex items-center shrink-0" aria-label="Dosanjh Labs — home">
        <Logo emblemSize={32} class="gap-2.5" />
      </a>

      <!-- Desktop links -->
      <ul class="hidden md:flex items-center gap-1" role="list">
        {nav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class:list={[
                'px-3.5 py-2 rounded-lg text-sm font-medium transition-colors',
                isActive(item.href)
                  ? 'text-kesari-300 bg-white/[0.04]'
                  : 'text-mist-400 hover:text-mist-100 hover:bg-white/[0.03]',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA + mobile toggle -->
      <div class="flex items-center gap-2">
        <a
          href={url('/contact')}
          class="hidden sm:inline-flex items-center gap-2 rounded-lg bg-kesari-500 text-ink-950 px-4 py-2 text-sm font-semibold hover:bg-kesari-400 transition-colors"
        >
          Let’s talk
        </a>
        <button
          id="nav-toggle"
          class="md:hidden grid place-items-center h-10 w-10 rounded-lg text-mist-200 hover:bg-white/5 transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line class="nav-line-1" x1="3" y1="7" x2="21" y2="7"/><line class="nav-line-2" x1="3" y1="12" x2="21" y2="12"/><line class="nav-line-3" x1="3" y1="17" x2="21" y2="17"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden hidden mt-2 glass rounded-2xl p-2">
      <ul class="flex flex-col" role="list">
        {nav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class:list={[
                'block px-4 py-3 rounded-lg text-[15px] font-medium transition-colors',
                isActive(item.href) ? 'text-kesari-300 bg-white/[0.04]' : 'text-mist-300 hover:bg-white/5',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="p-2">
          <a href={url('/contact')} class="block text-center rounded-lg bg-kesari-500 text-ink-950 px-4 py-3 font-semibold">Let’s talk</a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(open === false));
  });
  // close on navigation link tap
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => menu.classList.add('hidden'))
  );
</script>
