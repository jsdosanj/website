---
// Custom cursor: a small solid dot that tracks 1:1 and a larger ring that
// eases behind it, growing over interactive elements. Desktop only — the CSS
// hides both unless (hover: hover) and (pointer: fine), and the script bails on
// touch / reduced-motion so phones and tablets keep the native cursor.
---
<div class="cursor-dot" aria-hidden="true"></div>
<div class="cursor-ring" aria-hidden="true"></div>

<script>
  function initCursor() {
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dot = document.querySelector<HTMLElement>('.cursor-dot');
    const ring = document.querySelector<HTMLElement>('.cursor-ring');
    if (!fine || reduce || !dot || !ring) return;

    document.documentElement.classList.add('has-cursor');

    let mx = window.innerWidth / 2,
      my = window.innerHeight / 2;
    let rx = mx,
      ry = my;
    let raf = 0;

    const onMove = (e: PointerEvent) => {
      mx = e.clientX;
      my = e.clientY;
      dot.style.transform = `translate3d(${mx}px, ${my}px, 0) translate(-50%, -50%)`;
    };

    const loop = () => {
      rx += (mx - rx) * 0.18;
      ry += (my - ry) * 0.18;
      ring.style.transform = `translate3d(${rx}px, ${ry}px, 0) translate(-50%, -50%)`;
      raf = requestAnimationFrame(loop);
    };

    const hoverable = 'a, button, [role="button"], input, textarea, label, .term';
    const onOver = (e: Event) => {
      if ((e.target as HTMLElement).closest(hoverable)) ring.classList.add('is-hover');
    };
    const onOut = (e: Event) => {
      if ((e.target as HTMLElement).closest(hoverable)) ring.classList.remove('is-hover');
    };

    window.addEventListener('pointermove', onMove, { passive: true });
    document.addEventListener('pointerover', onOver, { passive: true });
    document.addEventListener('pointerout', onOut, { passive: true });
    loop();

    // Clean up before an Astro view transition swaps the DOM
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('pointermove', onMove);
    }, { once: true });
  }

  initCursor();
  document.addEventListener('astro:after-swap', initCursor);
</script>
