---
// Stylized Khanda emblem — line-art, used as a heritage motif (decorative).
interface Props {
  class?: string;
  size?: number;
}
const { class: className = '', size = 64 } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  stroke="currentColor"
  stroke-width="2.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <!-- Chakkar (ring) -->
  <circle cx="50" cy="52" r="26" stroke-width="2.4" />
  <!-- Left kirpan (curved sword) -->
  <path d="M30 26 C 18 40, 18 64, 34 76" />
  <!-- Right kirpan (curved sword) -->
  <path d="M70 26 C 82 40, 82 64, 66 76" />
  <!-- Central double-edged khanda blade -->
  <path d="M50 12 L 54 24 L 54 70 L 50 80 L 46 70 L 46 24 Z" />
  <!-- Blade tip highlight -->
  <path d="M50 12 L 50 80" stroke-width="1.4" opacity="0.6" />
</svg>
