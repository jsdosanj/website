---
// Personal heritage emblem — a refined Khanda-inspired mark (chakkar ring,
// central double-edged blade, two curved kirpans). Used as the personal logo
// across the site. Line-art, inherits currentColor.
interface Props {
  class?: string;
  size?: number;
  strokeWidth?: number;
}
const { class: className = '', size = 64, strokeWidth = 2.2 } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <!-- Chakkar (ring) -->
  <circle cx="50" cy="53" r="23" />
  <!-- Left kirpan -->
  <path d="M34 19 C 19 35, 19 71, 36 87" />
  <!-- Right kirpan -->
  <path d="M66 19 C 81 35, 81 71, 64 87" />
  <!-- Central double-edged blade (slim pointed lens) -->
  <path d="M50 9 C 45 33, 45 73, 50 97 C 55 73, 55 33, 50 9 Z" />
  <!-- Blade spine -->
  <path d="M50 14 L 50 92" stroke-width={strokeWidth * 0.6} opacity="0.55" />
</svg>
