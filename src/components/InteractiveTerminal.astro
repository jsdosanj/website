---
// Approachable, interactive terminal. Boots with a friendly typed intro, then
// invites visitors to run (or tap) commands and get plain-English answers — the
// terminal as something to learn and enjoy, not a wall. Fully keyboard- and
// tap-driven; degrades to readable static text without JS.
import { commands as rawCommands } from '../data/commands';
import { url } from '../utils';

const chips = ['help', 'whoami', 'skills', 'experience', 'projects', 'contact'];
// Shared with the ⌘K command palette — `open <name>` fuzzy-matches this list
// and actually navigates, instead of the terminal only describing things.
const openTargets = rawCommands.map((c) => ({
  id: c.id,
  label: c.label,
  action: c.action.type === 'navigate' ? { ...c.action, href: url(c.action.href) } : c.action,
}));
---
<div class="term" id="iterm" data-iterm>
  <div class="term-bar">
    <div class="term-lights" aria-hidden="true">
      <span class="term-light red"></span><span class="term-light amber"></span><span class="term-light green"></span>
    </div>
    <span class="term-title">jasvant@portfolio — zsh — try a command</span>
    <span class="w-[3.4rem]" aria-hidden="true"></span>
  </div>
  <div class="term-body">
    <div id="iterm-out" aria-live="polite">
      <noscript>
        <p><span class="term-user">jasvant@portfolio</span> <span class="term-prompt-sym">~ %</span> whoami</p>
        <p class="text-mist-100">Jasvant Singh Dosanjh · IT Manager · open to relocating — 10 years leading cross-functional IT teams.</p>
        <p class="mt-2 term-comment">Enable JavaScript to run commands, or explore the nav above.</p>
      </noscript>
    </div>
    <form id="iterm-form" class="flex items-center gap-2 mt-1" autocomplete="off">
      <span class="term-user shrink-0">jasvant@portfolio</span>
      <span class="term-prompt-sym shrink-0">~ %</span>
      <input
        id="iterm-in" name="cmd" type="text" spellcheck="false" autocapitalize="off" autocomplete="off"
        aria-label="Type a command"
        class="flex-1 bg-transparent border-0 outline-none text-mist-100 font-mono text-[0.86rem] placeholder:text-mist-600"
        placeholder="type 'help' and press enter…"
      />
    </form>
    <div class="mt-4 flex flex-wrap gap-1.5" id="iterm-chips">
      {chips.map((c) => (
        <button type="button" class="chip mono text-[11px] rounded-md border border-white/10 px-2.5 py-1 text-mist-400 hover:text-kesari-200 hover:border-kesari-500/40 transition-colors" data-cmd={c}>{c}</button>
      ))}
    </div>
  </div>
</div>

<script define:vars={{ openTargets }}>
  window.__openTargets = openTargets;
</script>

<script>
  type Cmd = () => string;
  type OpenAction =
    | { type: 'navigate'; href: string }
    | { type: 'external'; href: string }
    | { type: 'download'; href: string };
  type OpenTarget = { id: string; label: string; action: OpenAction };
  const openTargets = (window as any).__openTargets as OpenTarget[];
  const A = (href: string, label: string) => `<a href="${href}" class="text-kesari-300 underline underline-offset-2 hover:text-kesari-200">${label}</a>`;

  const COMMANDS: Record<string, Cmd> = {
    help: () =>
      `Available commands — type one, or tap a chip below:\n` +
      `  <span class="term-key">whoami</span>      who I am\n` +
      `  <span class="term-key">skills</span>      what I do, in plain English\n` +
      `  <span class="term-key">experience</span>  results from the last 10 years\n` +
      `  <span class="term-key">projects</span>    things I've built & shipped\n` +
      `  <span class="term-key">certs</span>       certifications\n` +
      `  <span class="term-key">resume</span>      download my résumé\n` +
      `  <span class="term-key">contact</span>     how to reach me\n` +
      `  <span class="term-key">open &lt;name&gt;</span>  jump to any page, product, or link — try <span class="term-key">open bastion</span>\n` +
      `  <span class="term-key">clear</span>       clear the screen`,
    whoami: () =>
      `Jasvant Singh Dosanjh — <span class="text-mist-100">IT Manager</span>, open to relocating.\n` +
      `10 years leading matrixed, cross-functional teams across higher ed, healthcare, gaming, and big tech.`,
    skills: () =>
      `I lead IT teams and programs and translate the technical for everyone in the room:\n` +
      `• SDLC ownership · Agile / Scrum delivery · vendor & budget management\n` +
      `• Security & GRC — HIPAA · FERPA · NIST\n` +
      `• Hands-on: Jamf · Intune · JumpCloud · cloud · AI tooling\n` +
      `→ more at ${A('/skills', 'cd ./skills')}`,
    experience: () =>
      `A few results:\n` +
      `<span class="term-ok">✔</span> led 9 staff as interim helpdesk manager @ UW\n` +
      `<span class="term-ok">✔</span> cut an escalated SLA 48h → 2h, saved $30k/yr\n` +
      `<span class="term-ok">✔</span> ran a 6-month, zero-downtime security migration\n` +
      `<span class="term-ok">✔</span> built a 12-product security & compliance suite\n` +
      `→ full story at ${A('/about', 'cd ./about')}`,
    projects: () =>
      `Things I've built: Sikhi University, Sightline, Bastion, and open-source\n` +
      `Cairn / Ledger / Lookout — plus a 758M-word AI dataset.\n` +
      `→ browse ${A('/products', 'ls ./products')}`,
    certs: () =>
      `PMI (2026): CPMAI™ · Agile PM · Predictive PM. PMP & CompTIA Security+ in progress.\n` +
      `Also: Jamf Pro · Google Cloud · NIST RMF · Harvard CS50 Cybersecurity.`,
    resume: () =>
      `Here's my IT Manager résumé (PDF): ${A('/resumes/JSD IT Manager Resume June 2026.pdf', 'download résumé.pdf')}`,
    contact: () =>
      `Easiest is the contact form — I read every message.\n` +
      `→ ${A('/contact', './hire-me')} · ${A('https://linkedin.com/in/jasvantsd', 'LinkedIn')} · ${A('https://github.com/jsdosanj', 'GitHub')}`,
    ls: () => `about  skills  products  writing  seva  contact`,
    sudo: () => `Nice try 😄 — you already have all the access you need here.`,
    hi: () => `👋 Hey! Type <span class="term-key">help</span> to see what I can show you.`,
  };
  COMMANDS.hello = COMMANDS.hi;
  COMMANDS.who = COMMANDS.whoami;

  function initIterm() {
    const root = document.getElementById('iterm');
    const out = document.getElementById('iterm-out');
    const form = document.getElementById('iterm-form') as HTMLFormElement | null;
    const input = document.getElementById('iterm-in') as HTMLInputElement | null;
    if (!root || !out || !form || !input) return;
    if ((root as any)._wired) return;
    (root as any)._wired = true;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const history: string[] = [];
    let hi = 0;

    const line = (html: string, cls = '') => {
      const p = document.createElement('p');
      if (cls) p.className = cls;
      p.innerHTML = html;
      out.appendChild(p);
      return p;
    };
    const promptEcho = (cmd: string) =>
      line(`<span class="term-user">jasvant@portfolio</span> <span class="term-prompt-sym">~ %</span> ${cmd.replace(/</g, '&lt;')}`);
    const block = (text: string) => {
      // preserve newlines as separate lines
      text.split('\n').forEach((l) => line(l || '&nbsp;', 'text-mist-300'));
    };

    const runOpenAction = (a: OpenAction) => {
      if (a.type === 'navigate') window.location.href = a.href;
      else if (a.type === 'external') window.open(a.href, '_blank', 'noopener,noreferrer');
      else if (a.type === 'download') {
        const link = document.createElement('a');
        link.href = a.href; link.download = '';
        document.body.appendChild(link); link.click(); link.remove();
      }
    };

    const openCommand = (query: string) => {
      const q = query.trim().toLowerCase();
      if (!q) { line(`usage: <span class="term-key">open &lt;name&gt;</span> — e.g. <span class="term-key">open bastion</span>, <span class="term-key">open products</span>`); return; }
      const starts = openTargets.filter((t) => t.label.toLowerCase().startsWith(q));
      const includes = openTargets.filter((t) => t.label.toLowerCase().includes(q));
      const match = starts[0] || includes[0];
      if (!match) {
        line(`<span class="text-mac-red">open: no match for "${query.replace(/</g, '&lt;')}"</span> — try <span class="term-key">projects</span> to see names`);
        return;
      }
      line(`<span class="term-ok">→ opening ${match.label}…</span>`);
      window.setTimeout(() => runOpenAction(match.action), 260);
    };

    const run = (raw: string) => {
      const cmd = raw.trim();
      if (!cmd) return;
      history.push(cmd); hi = history.length;
      promptEcho(cmd);
      const key = cmd.toLowerCase().split(/\s+/)[0];
      if (key === 'clear') { out.innerHTML = ''; return; }
      if (key === 'open') { openCommand(cmd.slice(cmd.toLowerCase().indexOf('open') + 4)); out.parentElement!.scrollTop = out.parentElement!.scrollHeight; return; }
      const fn = COMMANDS[key];
      if (fn) block(fn());
      else line(`<span class="text-mac-red">zsh: command not found: ${key.replace(/</g, '&lt;')}</span> — try <span class="term-key">help</span>`);
      out.parentElement!.scrollTop = out.parentElement!.scrollHeight;
    };

    form.addEventListener('submit', (e) => { e.preventDefault(); run(input.value); input.value = ''; });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp') { if (hi > 0) { hi--; input.value = history[hi] || ''; } e.preventDefault(); }
      else if (e.key === 'ArrowDown') { if (hi < history.length) { hi++; input.value = history[hi] || ''; } }
    });
    root.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((b) =>
      b.addEventListener('click', () => { run(b.dataset.cmd || ''); input.focus(); })
    );
    // clicking anywhere in the body focuses the prompt
    root.querySelector('.term-body')?.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('a, button')) input.focus();
    });

    // Friendly boot intro (typed), then hand over to the user.
    const intro = [
      { t: '$ welcome', c: 'term-user' },
      { t: '👋 Hi — I\'m an interactive terminal. I make the technical easy to follow.', c: 'text-mist-100' },
      { t: 'Type a command (or tap one below). Start with: help', c: 'term-comment' },
    ];
    if (reduce) { intro.forEach((l) => line(l.t, l.c)); return; }
    let i = 0;
    const step = () => {
      if (i >= intro.length) return;
      line(intro[i].t, intro[i].c);
      i++;
      window.setTimeout(step, 360);
    };
    window.setTimeout(step, 250);
  }

  initIterm();
  document.addEventListener('astro:page-load', initIterm);
</script>
