---
// Jali — a tiling lattice motif inspired by Sikh/Mughal architectural screens.
// Decorative background; rendered as a faint repeating SVG pattern.
interface Props {
  class?: string;
  opacity?: number;
}
const { class: className = '', opacity = 0.5 } = Astro.props;
const id = 'jali-' + Math.abs(('' + className).split('').reduce((a, c) => a + c.charCodeAt(0), 7));
---
<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  width="100%"
  height="100%"
  style={`opacity:${opacity}`}
  aria-hidden="true"
>
  <defs>
    <pattern id={id} width="56" height="56" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <g fill="none" stroke="currentColor" stroke-width="1">
        <circle cx="28" cy="28" r="16" />
        <circle cx="0" cy="0" r="16" />
        <circle cx="56" cy="0" r="16" />
        <circle cx="0" cy="56" r="16" />
        <circle cx="56" cy="56" r="16" />
        <rect x="22" y="22" width="12" height="12" transform="rotate(45 28 28)" />
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
