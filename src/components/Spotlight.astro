---
// Flashlight / spotlight portrait. A near-black, desaturated base photo sits
// under a brighter, warm-lit copy revealed through a soft-feathered circular
// mask. On desktop the beam tracks the cursor while it's over the portrait and
// pans down the face as you scroll; touch / reduced-motion get the scroll pan
// only (no cursor), so the face is always discoverable.
interface Props {
  src: string;
  alt: string;
  class?: string;
  /** focal point of the resting spotlight, e.g. "50% 34%" */
  focus?: string;
}
const { src, alt, class: className = '', focus = '50% 34%' } = Astro.props;
const [fx, fy] = focus.split(/\s+/);
---
<div
  class:list={['spot', className]}
  data-spot
  data-fx={fx}
  data-fy={fy}
  style={`--mx:${fx}; --my:${fy};`}
>
  <img class="spot-img spot-base" src={src} alt="" aria-hidden="true" loading="eager" decoding="async" />
  <img class="spot-img spot-reveal" src={src} alt={alt} loading="eager" decoding="async" />
  <div class="spot-glow" aria-hidden="true"></div>
  <div class="spot-grid" aria-hidden="true"></div>
  <div class="spot-vignette" aria-hidden="true"></div>
</div>

<script>
  function initSpotlights() {
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('[data-spot]').forEach((el) => {
      if ((el as any)._spotWired) return;
      (el as any)._spotWired = true;

      const fx = parseFloat(el.dataset.fx || '50');
      const fy = parseFloat(el.dataset.fy || '34');
      const r = () => el.getBoundingClientRect();

      let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0, hovering = false, visible = true;
      const b0 = r();
      cx = tx = (fx / 100) * b0.width;
      cy = ty = (fy / 100) * b0.height;

      // As the portrait scrolls up through the viewport, pan the beam down the
      // face (fy → fy+36%). 0 = portrait entering bottom, 1 = leaving top.
      const scrollY = () => {
        const b = r();
        const prog = Math.min(1, Math.max(0, 1 - b.bottom / (window.innerHeight + b.height)));
        return ((fy + prog * 36) / 100) * b.height;
      };
      const setRest = () => {
        if (hovering) return;
        const b = r();
        tx = (fx / 100) * b.width;
        ty = scrollY();
      };

      const loop = () => {
        cx += (tx - cx) * 0.15;
        cy += (ty - cy) * 0.15;
        el.style.setProperty('--mx', `${cx}px`);
        el.style.setProperty('--my', `${cy}px`);
        raf = visible ? requestAnimationFrame(loop) : 0;
      };
      const kick = () => { if (!raf && visible) raf = requestAnimationFrame(loop); };

      // pause the rAF when the portrait is off-screen
      if ('IntersectionObserver' in window) {
        new IntersectionObserver((ents) => {
          visible = ents[0].isIntersecting;
          kick();
        }, { rootMargin: '120px' }).observe(el);
      }

      if (fine && !reduce) {
        window.addEventListener('pointermove', (e) => {
          const b = r();
          const inside = e.clientX >= b.left && e.clientX <= b.right && e.clientY >= b.top && e.clientY <= b.bottom;
          if (inside) {
            hovering = true;
            el.classList.add('spot-on');
            tx = e.clientX - b.left;
            ty = e.clientY - b.top;
          } else if (hovering) {
            hovering = false;
            el.classList.remove('spot-on');
            setRest();
          }
          kick();
        }, { passive: true });
        window.addEventListener('scroll', () => { setRest(); kick(); }, { passive: true });
        window.addEventListener('resize', setRest, { passive: true });
        setRest();
        kick();
      } else {
        // touch / reduced motion: scroll-pan only, no cursor
        el.style.setProperty('--mx', `${fx}%`);
        const upd = () => { el.style.setProperty('--my', `${scrollY()}px`); };
        upd();
        if (!reduce) window.addEventListener('scroll', upd, { passive: true });
      }

      document.addEventListener('astro:before-swap', () => { cancelAnimationFrame(raf); visible = false; }, { once: true });
    });
  }

  initSpotlights();
  document.addEventListener('astro:page-load', initSpotlights);
</script>
