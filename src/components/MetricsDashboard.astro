---
// Delivery metrics as a grouped KPI panel rather than a flat strip of numbers.
// Each figure carries the program it came from, so a reader can trace "$750K"
// back to the Tencent buildout instead of taking it on faith — which is the
// difference between a dashboard and a wall of trivia.
import Icon from './Icon.astro';
import { metricGroups } from '../data/value';
---
<div class="reveal grid gap-5 sm:grid-cols-2">
  {metricGroups.map((g) => (
    <section class="card overflow-hidden" aria-labelledby={`kpi-${g.title.toLowerCase().replace(/\s+/g, '-')}`}>
      <header class="flex items-center gap-2.5 px-5 py-3 border-b border-navy-800/10 bg-paper-200/60">
        <span class="grid place-items-center h-7 w-7 rounded-lg bg-paper-50 border border-navy-800/12 text-kesari-600">
          <Icon name={g.icon} size={15} />
        </span>
        <h3 id={`kpi-${g.title.toLowerCase().replace(/\s+/g, '-')}`} class="mono text-[11px] font-semibold uppercase tracking-[0.16em] text-navy-800">{g.title}</h3>
      </header>
      <dl class="divide-y divide-navy-800/[0.07]">
        {g.metrics.map((m) => (
          <div class="flex items-baseline gap-4 px-5 py-3.5">
            <dd class="metric-value text-2xl sm:text-[1.7rem] shrink-0 tabular-nums">
              {m.value}{m.unit && <span class="text-base font-semibold text-kesari-700">{m.unit}</span>}
            </dd>
            <dt class="min-w-0">
              <span class="block text-[13px] leading-snug text-ink-700">{m.label}</span>
              <span class="block mono text-[10.5px] leading-snug text-ink-400 mt-0.5">{m.source}</span>
            </dt>
          </div>
        ))}
      </dl>
    </section>
  ))}
</div>
