---
interface Props {
  eyebrow?: string;
  title: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, align = 'left', class: className = '' } = Astro.props;
---
<div class:list={['reveal', align === 'center' && 'text-center mx-auto', className]}>
  {eyebrow && (
    <p class="mono text-xs uppercase tracking-[0.22em] text-kesari-400 flex items-center gap-2" class:list={[align === 'center' && 'justify-center']}>
      <span class="inline-block h-px w-6 bg-kesari-500/60"></span>{eyebrow}
    </p>
  )}
  <h2 class="mt-3 font-display text-3xl sm:text-4xl font-semibold tracking-tight text-mist-100">{title}</h2>
  <slot />
</div>
