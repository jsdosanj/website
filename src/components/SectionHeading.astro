---
interface Props {
  eyebrow?: string;
  title: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, align = 'left', class: className = '' } = Astro.props;
---
<div class:list={['reveal', align === 'center' && 'text-center mx-auto', className]}>
  {eyebrow && (
    <p class:list={['eyebrow', align === 'center' && 'eyebrow-center']}>{eyebrow}</p>
  )}
  <h2 class="mt-3 font-display text-3xl sm:text-4xl font-semibold tracking-tight text-navy-900">{title}</h2>
  <slot />
</div>
