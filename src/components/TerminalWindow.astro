---
// Reusable macOS Terminal window chrome: traffic lights + centered title.
// Body content goes in the default slot (already monospace via .term-body).
interface Props {
  title?: string;
  class?: string;
  bodyClass?: string;
  /** when true, the window lifts slightly on hover */
  interactive?: boolean;
}
const {
  title = 'jasvant@portfolio — zsh — 80×24',
  class: className = '',
  bodyClass = '',
  interactive = false,
} = Astro.props;
---
<div class:list={['term', interactive && 'card-hover', className]}>
  <div class="term-bar">
    <div class="term-lights" aria-hidden="true">
      <span class="term-light red"></span>
      <span class="term-light amber"></span>
      <span class="term-light green"></span>
    </div>
    <span class="term-title">{title}</span>
    <span class="w-[3.4rem]" aria-hidden="true"></span>
  </div>
  <div class:list={['term-body', bodyClass]}>
    <slot />
  </div>
</div>
