---
import type { Product } from '../data/products';
import { statusMeta } from '../data/products';
import Icon from './Icon.astro';

interface Props { product: Product; }
const { product } = Astro.props;
const meta = statusMeta[product.status];
const accentText = product.accent === 'kesari' ? 'text-kesari-400' : 'text-azure-400';
const accentDot = product.accent === 'kesari' ? 'bg-kesari-500' : 'bg-azure-500';
const statusColor =
  product.status === 'live' ? 'text-kesari-300 border-kesari-500/30 bg-kesari-500/10'
  : product.status === 'wip' ? 'text-azure-300 border-azure-500/30 bg-azure-500/10'
  : 'text-mist-400 border-white/10 bg-white/[0.03]';
---
<article class="card card-hover border-glow reveal p-6 sm:p-7 flex flex-col h-full">
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-center gap-3">
      <span class:list={['grid place-items-center h-11 w-11 rounded-xl bg-ink-800 border border-white/10', accentText]}>
        {product.gurmukhi
          ? <span class="gurmukhi text-xl leading-none">{product.gurmukhi}</span>
          : <span class="font-display font-bold text-lg">{product.name.charAt(0)}</span>}
      </span>
      <div>
        <h3 class="font-display text-lg font-semibold text-mist-100">{product.name}</h3>
        <p class="mono text-[11px] uppercase tracking-wider text-mist-500">{product.category}</p>
      </div>
    </div>
    <span class:list={['shrink-0 inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11px] font-medium', statusColor]}>
      <span>{meta.symbol}</span>{meta.label}
    </span>
  </div>

  <p class:list={['mt-5 text-sm font-medium', accentText]}>{product.tagline}</p>
  <p class="mt-2 text-sm leading-relaxed text-mist-400">{product.description}</p>

  <ul class="mt-5 space-y-2 flex-1">
    {product.highlights.map((h) => (
      <li class="flex gap-2.5 text-sm text-mist-300">
        <span class:list={['mt-1.5 h-1.5 w-1.5 rounded-full shrink-0', accentDot]}></span>
        <span set:html={h.replace(/`([^`]+)`/g, '<code class="mono text-xs bg-ink-700 text-mist-200 px-1.5 py-0.5 rounded">$1</code>')}></span>
      </li>
    ))}
  </ul>

  <div class="mt-6 flex flex-wrap gap-1.5">
    {product.tech.map((t) => (
      <span class="mono text-[11px] text-mist-400 border border-white/10 rounded-md px-2 py-1">{t}</span>
    ))}
  </div>

  {product.links.length > 0 && (
    <div class="mt-5 pt-5 hairline flex flex-wrap gap-3">
      {product.links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener noreferrer" class:list={['inline-flex items-center gap-2 text-sm font-medium hover:underline underline-offset-4', accentText]}>
          <Icon name={l.icon} size={15} />{l.label}
        </a>
      ))}
    </div>
  )}
</article>
