---
import type { Product } from '../data/products';
import { statusMeta } from '../data/products';
import { getLiveStats } from '../data/live';
import Icon from './Icon.astro';
import ProductVisual from './ProductVisual.astro';

interface Props { product: Product; }
const { product } = Astro.props;
const meta = statusMeta[product.status];

// Live PyPI version badge for the two packages actually published there —
// see src/data/live.ts. Memoized build-wide, so this costs nothing extra
// per card; omitted entirely if the slug isn't tracked or the fetch failed.
const livePackageKey = product.slug === 'gurmukhifix' ? 'gurmukhifix' : product.slug === 'cairn' ? 'cairn-sync' : null;
const liveVersion = livePackageKey ? (await getLiveStats()).packages[livePackageKey]?.version : undefined;
const accentText = product.accent === 'kesari' ? 'text-kesari-700' : 'text-navy-600';
const accentDot = product.accent === 'kesari' ? 'bg-kesari-500' : 'bg-navy-600';
const statusColor =
  product.status === 'live' ? 'text-kesari-700 border-kesari-500/30 bg-kesari-500/10'
  : product.status === 'beta' ? 'text-navy-600 border-navy-500/30 bg-navy-500/10'
  : product.status === 'wip' ? 'text-navy-600 border-navy-500/30 bg-navy-500/10'
  : 'text-ink-600 border-navy-800/12 bg-navy-900/[0.03]';
---
<article class="card card-hover border-glow reveal p-6 sm:p-6 flex flex-col h-full">
  <!-- generated cover art -->
  <div class="relative -mx-6 -mt-6 sm:-mx-7 sm:-mt-7 mb-5 rounded-t-[0.9rem] overflow-hidden border-b border-navy-800/[0.10]">
    <ProductVisual product={product} />
    {product.openSource && (
      <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-md bg-navy-950/70 backdrop-blur px-2 py-1 type-mono-sm text-status-green border border-status-green/20">
        <span class="h-1.5 w-1.5 rounded-full bg-status-green"></span>open source
      </span>
    )}
    {product.freeLimited && (
      <span class="absolute top-3 left-3 max-w-[calc(100%-1.5rem)] inline-flex items-center gap-1.5 rounded-md bg-navy-950/70 backdrop-blur px-2 py-1 type-mono-sm text-kesari-300 border border-kesari-400/25">
        <span class="h-1.5 w-1.5 rounded-full bg-kesari-400"></span>free · limited time
      </span>
    )}
  </div>
  <div class="flex items-start justify-between gap-4 min-w-0">
    <div class="flex items-center gap-3 min-w-0">
      <span class:list={['grid place-items-center h-11 w-11 rounded-xl bg-paper-200 border border-navy-800/12', accentText]}>
        {product.gurmukhi
          ? <span class="gurmukhi type-title-4 leading-none" lang="pa">{product.gurmukhi}</span>
          : <span class="font-display font-bold type-body">{product.name.charAt(0)}</span>}
      </span>
      <div>
        <h3 class="font-display type-body font-semibold text-navy-900">{product.name}</h3>
        {product.gurmukhiName && (
          <p class="gurmukhi type-subhead leading-tight text-ink-700" lang="pa">{product.gurmukhiName}</p>
        )}
        <p class="type-label text-ink-500 mt-0.5">{product.category}</p>
      </div>
    </div>
    <div class="shrink-0 flex flex-col items-end gap-1.5">
      <span class:list={['inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 type-caption-2 font-medium', statusColor]}>
        <span>{meta.symbol}</span>{meta.label}
      </span>
      {product.published && (
        <span class="type-mono-sm text-ink-500">{product.published === 'Ongoing' ? 'Ongoing' : `Published ${product.published}`}</span>
      )}
      {liveVersion && (
        <span class="inline-flex items-center gap-1 type-mono-sm text-status-green" title="Live version on PyPI">
          <span class="h-1.5 w-1.5 rounded-full bg-status-green animate-pulse-glow"></span>v{liveVersion}
        </span>
      )}
    </div>
  </div>

  <p class:list={['mt-5 type-subhead font-medium', accentText]}>{product.tagline}</p>
  <p class="mt-2 type-subhead leading-relaxed text-ink-600">{product.description}</p>

  <ul class="mt-5 space-y-2 flex-1">
    {product.highlights.map((h) => (
      <li class="flex gap-2.5 type-subhead text-ink-700">
        <span class:list={['mt-1.5 h-1.5 w-1.5 rounded-full shrink-0', accentDot]}></span>
        <span set:html={h.replace(/`([^`]+)`/g, '<code class="type-mono-sm bg-paper-300 text-ink-800 px-1.5 py-0.5 rounded">$1</code>')}></span>
      </li>
    ))}
  </ul>

  <div class="mt-6 flex flex-wrap gap-1.5">
    {product.tech.map((t) => (
      <span class="type-mono-sm text-ink-600 border border-navy-800/12 rounded-md px-2 py-1">{t}</span>
    ))}
  </div>

  {product.links.length > 0 && (
    <div class="mt-5 pt-5 hairline flex flex-wrap gap-3">
      {product.links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener noreferrer" class:list={['link-control type-subhead font-medium hover:underline underline-offset-4', accentText]}>
          <Icon name={l.icon} size={15} />{l.label}
        </a>
      ))}
    </div>
  )}
</article>
