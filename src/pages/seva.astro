---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import Khanda from '../components/Khanda.astro';
import Jali from '../components/Jali.astro';
import { sevaIntro, engagements, sevaValues } from '../data/seva';
---
<Base title="Seva & Parchar" description="The parcharik and community work of Jasvant Singh Dosanjh — speaking with Basics of Sikhi, preserving heritage with SikhArchive.net, and carrying the message of Guru Nanak worldwide.">
  <!-- Hero -->
  <section class="relative pt-36 sm:pt-48 pb-8 overflow-hidden">
    <Jali class="absolute inset-0 text-kesari-500/[0.10]" opacity={1} />
    <div class="absolute left-1/2 -translate-x-1/2 top-24 h-72 w-72 rounded-full bg-kesari-500/10 blur-[100px]"></div>
    <div class="container-x relative text-center">
      <p class="gurmukhi text-5xl sm:text-6xl text-kesari-400 reveal is-visible animate-pulse-glow">{sevaIntro.gurmukhi}</p>
      <p class="reveal is-visible mt-3 mono text-xs uppercase tracking-[0.25em] text-mist-500">{sevaIntro.mool}</p>
      <h1 class="reveal is-visible mt-6 font-display text-4xl sm:text-5xl font-bold tracking-tight text-mist-100">{sevaIntro.heading}</h1>
      <p class="reveal is-visible mt-6 max-w-2xl mx-auto text-lg text-mist-400 leading-relaxed">{sevaIntro.lead}</p>
    </div>
  </section>

  <!-- Values -->
  <section class="container-x mt-14">
    <div class="grid gap-5 sm:grid-cols-3">
      {sevaValues.map((v) => (
        <div class="reveal card card-hover border-glow p-7 text-center">
          <p class="gurmukhi text-3xl text-kesari-400">{v.gurmukhi}</p>
          <h3 class="mt-3 font-display text-lg font-semibold text-mist-100">{v.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-mist-400">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Engagements -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Where I serve" title="Speaking & community work" />
    <div class="mt-10 space-y-5">
      {engagements.map((e, i) => (
        <div class="reveal card card-hover p-6 sm:p-8">
          <div class="grid lg:grid-cols-[auto_1fr] gap-5 sm:gap-7 items-start">
            <span class="grid place-items-center h-14 w-14 rounded-2xl bg-ink-800 border border-kesari-500/20 text-kesari-400">
              <Icon name={i === 0 ? 'mic' : i === 1 ? 'book' : i === 2 ? 'globe' : 'code'} size={26} />
            </span>
            <div>
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <h3 class="font-display text-lg font-semibold text-mist-100">{e.org}</h3>
                <span class="mono text-xs text-mist-500 shrink-0">{e.date}</span>
              </div>
              <p class="text-kesari-300 text-sm font-medium mt-0.5">{e.role}</p>
              <p class="mt-3 text-sm leading-relaxed text-mist-400">{e.description}</p>
              <div class="mt-4 flex flex-wrap items-center gap-2">
                {e.tags.map((t) => (
                  <span class="mono text-[11px] text-mist-400 border border-white/10 rounded-md px-2 py-1">{t}</span>
                ))}
                {e.link && (
                  <a href={e.link.href} target="_blank" rel="noopener noreferrer" class="ml-auto inline-flex items-center gap-1.5 text-sm font-medium text-kesari-300 hover:underline underline-offset-4">
                    <Icon name="external" size={14} /> {e.link.label}
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Heritage + tech bridge -->
  <section class="container-x mt-28">
    <div class="reveal relative card border-glow overflow-hidden p-8 sm:p-12 text-center">
      <Jali class="absolute inset-0 text-azure-500/[0.08]" opacity={1} />
      <div class="relative">
        <Khanda size={64} class="mx-auto text-kesari-400 animate-float" />
        <h2 class="mt-6 font-display text-2xl sm:text-3xl font-semibold text-mist-100 max-w-2xl mx-auto">Where the seva meets the science</h2>
        <p class="mt-4 max-w-2xl mx-auto text-mist-400 leading-relaxed">
          The parchar and the products are the same mission in two languages. The open dataset and OCR engines I build at Dosanjh Labs
          exist so that 758 million+ words of Sikh heritage — manuscripts, scripture, and history — can be searched, understood,
          and shared by the global Sangat. Preservation is seva. Access is seva. Building the tools is seva.
        </p>
        <p class="mt-6 gurmukhi text-xl text-kesari-300">ਚੜ੍ਹਦੀ ਕਲਾ</p>
      </div>
    </div>
  </section>
</Base>
