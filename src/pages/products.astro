---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { products } from '../data/products';
import { site } from '../data/site';
import { url } from '../utils';

const live = products.filter((p) => p.status === 'live');
const building = products.filter((p) => p.status !== 'live');
const openSource = products.filter((p) => p.openSource);

// Rich structured data: each product as a CreativeWork/SoftwareApplication in an ItemList
const productsJsonld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Dosanjh Labs — Products',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: p.name,
      applicationCategory: p.category,
      description: p.description,
      operatingSystem: 'Web, macOS, Windows, Linux',
      author: { '@type': 'Person', name: site.founder },
      ...(p.links[0] ? { url: p.links[0].href } : {}),
    },
  })),
};
---
<Base
  title="Products"
  description="The products of Dosanjh Labs by Jasvant Singh Dosanjh — Sightline (device health), GurmukhiFix (South Asian OCR), Cairn (team knowledge), and the 758M-word Sikh Library AI dataset."
  keywords={["Sightline", "GurmukhiFix", "Cairn", "SikhLibrary dataset", "Gurmukhi OCR", "endpoint health dashboard", "AI heritage tools"]}
  jsonld={productsJsonld}
>
  <section class="container-x pt-36 sm:pt-44">
    <div class="max-w-3xl">
      <p class="mono text-xs uppercase tracking-[0.22em] text-kesari-400 flex items-center gap-2 reveal is-visible">
        <span class="inline-block h-px w-6 bg-kesari-500/60"></span>$ ls ./products
      </p>
      <h1 class="reveal is-visible mt-4 font-display text-4xl sm:text-5xl font-bold tracking-tight text-mist-100">
        Tools that turn friction into <span class="text-kesari-gradient">momentum.</span>
      </h1>
      <p class="reveal is-visible mt-5 text-lg text-mist-400 leading-relaxed">
        Every product here exists because something that should have been easy was needlessly hard —
        OCR that fails on the world’s scripts, knowledge locked in manuscripts, fleets that break before anyone notices.
        Some are live today; others are taking shape on the workbench.
      </p>
    </div>

    <!-- Dosanjh Labs banner -->
    <div class="reveal is-visible mt-10 card border-glow p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center gap-5 justify-between">
      <div class="flex items-start gap-4">
        <span class="grid place-items-center h-12 w-12 shrink-0 rounded-xl bg-ink-800 border border-white/10 text-kesari-400"><Icon name="sparkles" size={22} /></span>
        <div>
          <p class="font-display text-lg font-semibold text-mist-100">Built &amp; sold under <span class="text-kesari-400">Dosanjh Labs</span></p>
          <p class="mt-1 max-w-xl text-sm leading-relaxed text-mist-400">
            My commercial security &amp; compliance suite — Sightline, Bastion, Lookout, and Cairn — is the studio I build and sell through.
            Visit the storefront for pricing, docs, and product pages.
          </p>
        </div>
      </div>
      <a href="https://dosanjhlabs.com" target="_blank" rel="noopener noreferrer" class="shrink-0 inline-flex items-center gap-2 rounded-xl bg-kesari-500 text-ink-950 px-5 py-3 font-semibold hover:bg-kesari-400 transition-colors">
        dosanjhlabs.com <Icon name="external" size={18} />
      </a>
    </div>
  </section>

  <!-- Open source -->
  <section class="container-x mt-16">
    <SectionHeading eyebrow="$ git clone — free & open" title="Open source">
      <p class="reveal mt-4 max-w-xl text-mist-400">Tools I’ve open-sourced for IT and security teams to run, audit, and self-host — no lock-in.</p>
    </SectionHeading>
    <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {openSource.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <!-- Live -->
  <section class="container-x mt-20">
    <SectionHeading eyebrow="Shipping now" title="Live products" />
    <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {live.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <!-- In progress / planned -->
  <section class="container-x mt-20">
    <SectionHeading eyebrow="On the workbench" title="In progress & in the lab">
      <p class="reveal mt-4 max-w-xl text-mist-400">Early-stage builds and concepts I’m actively shaping. Want to collaborate or pilot one? <a href={url('/contact')} class="text-kesari-300 hover:underline underline-offset-4">Reach out</a>.</p>
    </SectionHeading>
    <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {building.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <!-- CTA -->
  <section class="container-x mt-24">
    <div class="reveal card border-glow p-8 sm:p-10 text-center">
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-mist-100">More on the way.</h2>
      <p class="mt-3 max-w-lg mx-auto text-mist-400">Dosanjh Labs is a living workshop. Browse the storefront, follow along on GitHub and HuggingFace, or tell me what you wish existed.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="https://dosanjhlabs.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl bg-kesari-500 text-ink-950 px-5 py-3 font-semibold hover:bg-kesari-400 transition-colors"><Icon name="external" size={18} /> dosanjhlabs.com</a>
        <a href={site.socials.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl glass px-5 py-3 font-semibold text-mist-200 hover:border-white/20 transition-colors"><Icon name="github" size={18} /> GitHub</a>
        <a href={site.socials.huggingface} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl glass px-5 py-3 font-semibold text-mist-200 hover:border-white/20 transition-colors"><Icon name="sparkles" size={18} /> HuggingFace</a>
      </div>
    </div>
  </section>
</Base>
