---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Khanda from '../components/Khanda.astro';
import Jali from '../components/Jali.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';
import { products } from '../data/products';
import { helpAreas, outcomes } from '../data/value';
import { recommendations } from '../data/recommendations';
import { url } from '../utils';

const featured = products.filter((p) => p.featured);

const principles = [
  { icon: 'workflow', title: 'Built to outlive me', text: 'Every framework I ship is designed to be replicable — adopted beyond its original scope, so the next team never re-solves a solved problem.' },
  { icon: 'sparkles', title: 'AI as a force multiplier', text: 'From RAG over a 758M-word corpus to OCR repair for endangered scripts, I use AI to make hard problems tractable — and rare knowledge accessible.' },
  { icon: 'shield', title: 'Compliant & secure by default', text: 'A decade across healthcare, education, and big tech taught me to build with NIST, HIPAA, and FERPA baked in — not bolted on.' },
  { icon: 'globe', title: 'Technology for human good', text: 'The throughline from infrastructure to heritage preservation: tools that uplift people and make teams unstoppable.' },
];
---
<Base
  description="Jasvant Singh Dosanjh — senior IT leader, technical project & program manager, and systems administrator in Seattle. 10+ years across healthcare, higher ed, gaming, and big tech. Open to TPM, Customer Success, and Senior Systems Administrator roles."
  keywords={["Seattle Technical Project Manager", "Technical Program Manager", "Senior Systems Administrator", "Customer Success Manager", "IT Manager Seattle", "open to work", "Jamf Pro", "Intune", "NIST", "HIPAA"]}
>
  <!-- ===================== HERO ===================== -->
  <section class="relative pt-36 sm:pt-44 pb-16 overflow-hidden">
    <Jali class="absolute -top-24 right-[-10%] w-[42rem] h-[42rem] text-azure-500/[0.12] pointer-events-none" opacity={1} />
    <div class="container-x relative">
      <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-12 lg:gap-8 items-center">
        <div class="reveal is-visible">
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3.5 py-1.5 text-xs font-medium text-emerald-300">
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse-glow"></span>
            Open to new roles · Seattle / Remote
          </span>
          <h1 class="mt-6 font-display text-4xl sm:text-5xl lg:text-[3.5rem] font-bold leading-[1.05] tracking-tight text-mist-100">
            Senior IT leader,
            <span class="text-gradient"> builder, problem-solver.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-mist-400">
            I’m <span class="text-mist-200 font-medium">Jasvant Singh Dosanjh</span> — 10+ years turning broken infrastructure,
            stalled programs, and lost trust into outcomes that scale, across healthcare, higher ed, gaming, and big tech.
            The kind of hire whose frameworks outlive their tenure.
          </p>
          <!-- target roles -->
          <div class="mt-6 flex flex-wrap gap-2">
            {site.roles.map((r) => (
              <span class="rounded-lg bg-white/[0.04] border border-white/10 text-mist-200 px-3 py-1.5 text-sm font-medium">{r}</span>
            ))}
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={url('/contact')} class="group inline-flex items-center gap-2 rounded-xl bg-kesari-500 text-ink-950 px-5 py-3 font-semibold hover:bg-kesari-400 transition-colors">
              Let’s talk
              <Icon name="arrow" size={18} class="group-hover:translate-x-0.5 transition-transform" />
            </a>
            <a href="#impact" class="inline-flex items-center gap-2 rounded-xl glass px-5 py-3 font-semibold text-mist-200 hover:text-mist-100 hover:border-white/20 transition-colors">
              See my impact
            </a>
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-4 text-sm">
            <a href={site.resumes.tpm} download class="inline-flex items-center gap-2 text-mist-300 hover:text-kesari-300 transition-colors"><Icon name="file" size={16} /> TPM Résumé</a>
            <a href={site.resumes.csm} download class="inline-flex items-center gap-2 text-mist-300 hover:text-kesari-300 transition-colors"><Icon name="file" size={16} /> CSM Résumé</a>
            <span class="text-mist-600">·</span>
            <a href={site.socials.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-mist-300 hover:text-kesari-300 transition-colors"><Icon name="linkedin" size={16} /> LinkedIn</a>
          </div>
        </div>

        <!-- Portrait -->
        <div class="reveal is-visible relative mx-auto lg:mx-0 max-w-sm w-full">
          <div class="relative rounded-[1.75rem] overflow-hidden border border-white/10 glow-ring">
            <img src={url('/images/headshot.jpg')} alt="Jasvant Singh Dosanjh, Technical Project Manager in Seattle" class="w-full aspect-[4/5] object-cover" loading="eager" width="640" height="800" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-950/70 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 glass rounded-xl px-4 py-3 flex items-center justify-between">
              <div>
                <p class="font-display text-sm font-semibold text-mist-100">Jasvant Singh Dosanjh</p>
                <p class="mono text-[11px] text-mist-400">Technical Program Manager · Seattle</p>
              </div>
              <span class="gurmukhi text-kesari-400 text-xl">ੴ</span>
            </div>
          </div>
          <Khanda size={70} class="absolute -top-7 -left-7 text-kesari-400/80 animate-float drop-shadow-[0_0_18px_rgba(240,169,60,0.35)]" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== HOW I HELP ===================== -->
  <section class="container-x mt-12">
    <SectionHeading eyebrow="What I bring to your team" title="Three ways I make organizations better" align="center">
      <p class="reveal mt-4 max-w-2xl mx-auto text-mist-400">I’ve worn each of these hats — often at the same time. Whichever role you’re hiring for, here’s the value I drop in on day one.</p>
    </SectionHeading>
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {helpAreas.map((a) => (
        <div class="reveal card card-hover border-glow p-7 flex flex-col">
          <span class="grid place-items-center h-12 w-12 rounded-xl bg-ink-800 border border-white/10 text-kesari-400"><Icon name={a.icon} size={22} /></span>
          <h3 class="mt-5 font-display text-lg font-semibold text-mist-100">{a.role}</h3>
          <p class="mt-2 text-sm leading-relaxed text-mist-400">{a.blurb}</p>
          <ul class="mt-5 space-y-2.5 flex-1">
            {a.proof.map((p) => (
              <li class="flex gap-2.5 text-sm text-mist-300"><Icon name="shield" size={15} class="text-kesari-500/70 shrink-0 mt-0.5" /><span>{p}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== IMPACT / OUTCOMES ===================== -->
  <section id="impact" class="container-x mt-28 scroll-mt-28">
    <SectionHeading eyebrow="Proof, not promises" title="Signature outcomes" align="center">
      <p class="reveal mt-4 max-w-2xl mx-auto text-mist-400">A sample of what “invaluable” looks like in numbers. Every one of these is real, and most were adopted far beyond my original scope.</p>
    </SectionHeading>
    <div class="reveal mt-12 grid grid-cols-2 lg:grid-cols-4 gap-px bg-white/[0.06] rounded-2xl overflow-hidden border border-white/[0.06]">
      {outcomes.map((o) => (
        <div class="bg-ink-850/80 p-6 sm:p-7">
          <p class="font-display text-3xl sm:text-[2rem] font-bold text-kesari-gradient leading-none">{o.value}</p>
          <p class="mt-3 text-xs sm:text-sm text-mist-400 leading-snug">{o.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== SOCIAL PROOF ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="What colleagues say" title="Trusted by the people he’s served" align="center" />
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {recommendations.map((r) => (
        <figure class="reveal card p-6 flex flex-col">
          <div class="text-kesari-500/40 font-display text-4xl leading-none">“</div>
          <blockquote class="-mt-2 text-sm leading-relaxed text-mist-300 flex-1">{r.text}</blockquote>
          <figcaption class="mt-5 pt-5 hairline">
            <p class="font-display text-sm font-semibold text-mist-100">{r.name}</p>
            <p class="text-xs text-mist-500 mt-0.5">{r.title}</p>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="reveal mt-6 text-center">
      <a href={url('/about')} class="inline-flex items-center gap-2 text-sm font-medium text-kesari-300 hover:gap-3 transition-all">Read the full story & track record <Icon name="arrow" size={16} /></a>
    </div>
  </section>

  <!-- ===================== PRODUCTS (proof he builds) ===================== -->
  <section class="container-x mt-28">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="I don’t just manage — I build" title="Products from the lab">
        <p class="reveal mt-4 max-w-xl text-mist-400">Most managers can’t ship. These are tools I designed and built myself — proof I understand what I’m leading, end to end.</p>
      </SectionHeading>
      <a href={url('/products')} class="reveal inline-flex items-center gap-2 text-sm font-medium text-kesari-300 hover:gap-3 transition-all">View all <Icon name="arrow" size={16} /></a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {featured.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <!-- ===================== PRINCIPLES ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="How I work" title="A few principles that hold across everything" align="center" />
    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {principles.map((p) => (
        <div class="reveal card card-hover p-7 flex gap-5">
          <span class="shrink-0 grid place-items-center h-12 w-12 rounded-xl bg-ink-800 border border-white/10 text-kesari-400">
            <Icon name={p.icon} size={22} />
          </span>
          <div>
            <h3 class="font-display text-lg font-semibold text-mist-100">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-mist-400">{p.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== SEVA TEASER ===================== -->
  <section class="container-x mt-28">
    <div class="reveal relative card border-glow overflow-hidden p-8 sm:p-12">
      <Jali class="absolute inset-0 text-kesari-500/[0.08]" opacity={1} />
      <div class="relative grid lg:grid-cols-[1fr_auto] gap-8 items-center">
        <div>
          <p class="gurmukhi text-3xl text-kesari-400">ੴ</p>
          <h2 class="mt-3 font-display text-2xl sm:text-3xl font-semibold text-mist-100">The character behind the résumé</h2>
          <p class="mt-4 max-w-2xl text-mist-400 leading-relaxed">
            Beyond the work, I serve as a parcharik — speaking at community events worldwide and preserving Sikh heritage with
            <span class="text-mist-200"> Basics of Sikhi</span> and <span class="text-mist-200">SikhArchive.net</span>.
            The same instinct drives the code and the seva: leadership rooted in service, resilience, and people-first values.
          </p>
          <a href={url('/seva')} class="mt-6 inline-flex items-center gap-2 rounded-xl glass px-5 py-3 font-semibold text-kesari-300 hover:border-kesari-500/40 transition-colors">
            See who I am beyond work <Icon name="arrow" size={18} />
          </a>
        </div>
        <Khanda size={140} class="hidden lg:block text-kesari-400/70 animate-float" />
      </div>
    </div>
  </section>

  <!-- ===================== FINAL CTA ===================== -->
  <section class="container-x mt-28">
    <div class="reveal card border-glow p-8 sm:p-12 text-center">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold text-mist-100">Hiring for TPM, Customer Success, or Systems Admin?</h2>
      <p class="mt-4 max-w-xl mx-auto text-mist-400">Let’s talk about how I can drive infrastructure efficiency, customer adoption, and compliant, scalable IT for your team — starting on day one.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={url('/contact')} class="inline-flex items-center gap-2 rounded-xl bg-kesari-500 text-ink-950 px-6 py-3.5 font-semibold hover:bg-kesari-400 transition-colors">Let’s talk <Icon name="arrow" size={18} /></a>
        <a href={site.resumes.tpm} download class="inline-flex items-center gap-2 rounded-xl glass px-5 py-3.5 font-semibold text-mist-200 hover:border-white/20 transition-colors"><Icon name="file" size={18} /> Download résumé</a>
      </div>
    </div>
  </section>
</Base>
