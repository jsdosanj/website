---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Khanda from '../components/Khanda.astro';
import Jali from '../components/Jali.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Spotlight from '../components/Spotlight.astro';
import InteractiveTerminal from '../components/InteractiveTerminal.astro';
import BinaryRain from '../components/BinaryRain.astro';
import Marquee from '../components/Marquee.astro';
import { site } from '../data/site';
import { products } from '../data/products';
import { helpAreas, outcomes } from '../data/value';
import { recommendations } from '../data/recommendations';
import { url } from '../utils';

const stackTop = [
  'Jamf Pro', 'Microsoft Intune', 'JumpCloud', 'Google Workspace', 'Windows Server',
  'AWS', 'Azure', 'Cloudflare', 'CrowdStrike', 'Snipe-IT',
];
const stackBottom = [
  'Agile / Scrum', 'SAFe', 'Jira', 'Confluence', 'Workday', 'Azure DevOps',
  'NIST CSF', 'HIPAA', 'FERPA', 'CMMC', 'Python', 'Bash', 'CI/CD',
];

const featured = products.filter((p) => p.featured);

const principles = [
  { icon: 'workflow', title: 'Run it like a program', text: 'Matrixed teams, vendors, and budgets aligned to outcomes. I own the SDLC end to end, run Agile delivery that ships, and keep a roadmap stakeholders actually trust.' },
  { icon: 'shield', title: 'Compliant & secure by default', text: 'A decade across healthcare, education, and big tech taught me to build with NIST, HIPAA, and FERPA baked in — not bolted on.' },
  { icon: 'sparkles', title: 'AI that earns its keep', text: 'A hands-on practitioner. I ship real tools with AI, from a 12-product compliance suite to OCR repair for endangered scripts, that help teams move faster.' },
  { icon: 'globe', title: 'Technology for human good', text: 'The throughline from infrastructure to heritage preservation: tools and teams that uplift people and help them do their best work.' },
];
---
<Base
  description="Jasvant Singh Dosanjh — IT Manager, open to relocating. 10 years leading teams across healthcare, education, gaming, and big tech: SDLC, Agile, GRC, hands-on AI."
  keywords={["IT Program Manager", "IT Project Manager", "helpdesk manager", "Jamf Pro", "Intune", "JumpCloud", "NIST", "HIPAA", "FERPA", "vendor management", "Agile", "open to work"]}
  preloadImage="/images/headshot-spotlight.jpg"
  ogImage="/og/home.png"
>
  <!-- ===================== HERO ===================== -->
  <section class="relative pt-32 sm:pt-40 pb-12 overflow-hidden">
    <Jali class="absolute -top-24 right-[-10%] w-[42rem] h-[42rem] text-azure-500/[0.10] pointer-events-none" opacity={1} />
    <div class="container-x relative">
      <!-- eyebrow path + auto-scrolling status banner -->
      <div class="reveal mono text-xs sm:text-sm text-mist-500 flex items-center gap-2 max-w-full">
        <span class="text-mist-400 shrink-0">~</span>
        <span class="text-mist-600 shrink-0">—</span>
        <div class="marquee min-w-0 flex-1" data-marquee style="--marquee-dur:22s">
          <div class="marquee__viewport">
            <div class="marquee__track">
              <span class="inline-flex items-center gap-1.5 text-phos-400 pr-10"><span class="h-1.5 w-1.5 rounded-full bg-phos-400 animate-pulse-glow shrink-0"></span>open to work · in-person / hybrid / remote · open to relocating</span>
            </div>
            <div class="marquee__track" aria-hidden="true">
              <span class="inline-flex items-center gap-1.5 text-phos-400 pr-10"><span class="h-1.5 w-1.5 rounded-full bg-phos-400 animate-pulse-glow shrink-0"></span>open to work · in-person / hybrid / remote · open to relocating</span>
            </div>
          </div>
          <button type="button" class="marquee__toggle" data-marquee-toggle aria-label="Pause scrolling">
            <span aria-hidden="true">❙❙</span>
          </button>
        </div>
      </div>

      <div class="mt-8 grid lg:grid-cols-[1.08fr_0.92fr] gap-12 lg:gap-16 items-center">
        <!-- Left: headline + CTAs -->
        <div class="order-2 lg:order-1">
          <h1 class="font-display text-[2.7rem] sm:text-6xl lg:text-[4.4rem] font-bold leading-[0.96] tracking-tight text-mist-100" data-kinetic>
            <span class="kin-line"><span class="kin-inner">IT Manager who</span></span>
            <span class="kin-line"><span class="kin-inner text-gradient">sprints, ships &amp; scales.</span></span>
          </h1>
          <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-mist-400">
            I’m <span class="text-mist-200 font-medium">Jasvant Singh Dosanjh</span> — 10 years leading matrixed,
            cross-functional teams across higher ed, healthcare, gaming, and big tech. I own the SDLC, run Agile
            delivery, automate the busywork, manage vendors and budgets, and keep it all audit-ready.
          </p>

          <!-- target roles -->
          <div class="reveal mt-6 flex flex-wrap gap-2">
            {site.roles.map((r) => (
              <span class="mono rounded-lg bg-white/[0.04] border border-white/10 text-mist-200 px-3 py-1.5 text-[13px]">{r}</span>
            ))}
          </div>

          <!-- CTAs -->
          <div class="reveal mt-8 flex flex-wrap gap-3">
            <a href={url('/contact')} data-magnetic="0.4" class="group inline-flex items-center gap-2 rounded-xl bg-kesari-500 text-ink-950 px-5 py-3 font-semibold mono hover:bg-kesari-400 transition-colors">
              ./hire-me
              <Icon name="arrow" size={18} class="group-hover:translate-x-0.5 transition-transform" />
            </a>
            <a href={`${url('/contact')}#resumes`} data-magnetic="0.3" class="inline-flex items-center gap-2 rounded-xl glass px-5 py-3 font-semibold mono text-mist-200 hover:text-mist-100 hover:border-white/20 transition-colors">
              <Icon name="file" size={17} /> résumé.pdf
            </a>
          </div>

          <!-- quick links (contact happens via the form — no inbox/phone exposed) -->
          <div class="reveal mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 mono text-sm">
            <a href={site.socials.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-mist-400 hover:text-kesari-300 transition-colors"><Icon name="linkedin" size={16} /> LinkedIn</a>
            <a href={site.socials.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-mist-400 hover:text-kesari-300 transition-colors"><Icon name="github" size={16} /> GitHub</a>
            <a href={url('/contact')} class="inline-flex items-center gap-2 text-mist-400 hover:text-kesari-300 transition-colors"><Icon name="arrow" size={15} /> Get in touch</a>
          </div>
        </div>

        <!-- Right: spotlight portrait (flashlight reveal) -->
        <div class="reveal order-1 lg:order-2 relative mx-auto w-full max-w-[20rem] sm:max-w-[22rem] lg:max-w-none">
          <div class="relative rounded-[1.6rem] border border-white/10 overflow-hidden border-glow shadow-[0_44px_100px_-50px_rgba(0,0,0,0.95)]" data-parallax="0.05">
            <Spotlight
              src={url('/images/headshot-spotlight.jpg')}
              alt="Jasvant Singh Dosanjh, IT Manager"
              class="aspect-[4/5]"
              focus="50% 46%"
            />
            <!-- corner labels -->
            <span class="pointer-events-none absolute top-4 left-4 mono text-[10px] tracking-[0.28em] text-mist-300/80">IT&nbsp;MANAGER</span>
            <span class="pointer-events-none absolute top-3.5 right-4 gurmukhi text-kesari-300/90 text-lg leading-none" lang="pa">ੴ</span>
            <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 [writing-mode:vertical-rl] mono text-[10px] tracking-[0.3em] text-mist-400/60">EST. 2016 · AVAILABLE</span>
            <!-- desktop reveal hint -->
            <span class="pointer-events-none absolute top-4 left-1/2 -translate-x-1/2 hidden lg:flex items-center gap-1.5 mono text-[10px] text-mist-400/70"><span class="h-1 w-1 rounded-full bg-kesari-400 animate-pulse-glow"></span>move cursor to reveal</span>
            <!-- name plate -->
            <div class="pointer-events-none absolute inset-x-0 bottom-0 p-4 sm:p-5 bg-gradient-to-t from-ink-950/90 via-ink-950/40 to-transparent">
              <p class="font-display text-lg font-semibold text-mist-100 leading-none">Jasvant Singh Dosanjh</p>
              <p class="mono text-[11px] text-kesari-300 mt-1.5">Open to Relocating · 10 yrs · open to work</p>
            </div>
          </div>
          <Khanda size={54} class="absolute -top-5 -right-4 text-kesari-400/80 animate-float drop-shadow-[0_0_18px_rgba(240,169,60,0.35)]" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== INTERACTIVE TERMINAL ===================== -->
  <section class="relative mt-12 sm:mt-16 overflow-hidden">
    <BinaryRain class="opacity-40" opacity={0.4} />
    <div class="container-x relative">
      <p class="reveal mono text-xs uppercase tracking-[0.22em] text-kesari-400 flex items-center gap-2 mb-5"><span class="inline-block h-px w-6 bg-kesari-500/60"></span>$ try the terminal — it's friendly, I promise</p>
      <div class="reveal mx-auto max-w-3xl" data-parallax="0.03">
        <InteractiveTerminal />
      </div>
    </div>
  </section>

  <!-- ===================== STACK MARQUEE (counter-scrolling rows) ===================== -->
  <section class="mt-12 sm:mt-16 py-6 border-y border-white/[0.07] bg-ink-900/40 space-y-3" aria-label="Tools, platforms, and frameworks I work with">
    <Marquee items={stackTop} dur={52} label="Platforms and tools, row 1" />
    <Marquee items={stackBottom} dur={58} reverse label="Methods and frameworks, row 2" />
  </section>

  <!-- ===================== OUTCOMES STRIP ===================== -->
  <section id="impact" class="container-x mt-16 sm:mt-24 scroll-mt-28">
    <p class="reveal mono text-xs uppercase tracking-[0.22em] text-kesari-400 flex items-center gap-2"><span class="inline-block h-px w-6 bg-kesari-500/60"></span>$ cat impact.log</p>
    <div class="reveal mt-6 grid grid-cols-2 lg:grid-cols-4 gap-px bg-white/[0.06] rounded-2xl overflow-hidden border border-white/[0.06]">
      {outcomes.map((o) => (
        <div class="bg-ink-850/80 p-6 sm:p-7">
          <p class="font-display text-3xl sm:text-[2rem] font-bold text-kesari-gradient leading-none">{o.value}</p>
          <p class="mt-3 text-xs sm:text-sm text-mist-400 leading-snug">{o.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== HOW I HELP ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="What I bring to your team" title="Three ways I add value on day one" align="center">
      <p class="reveal mt-4 max-w-2xl mx-auto text-mist-400">I’ve worn each of these hats — often at the same time. Whichever role you’re hiring for, here’s where I’d start.</p>
    </SectionHeading>
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {helpAreas.map((a) => (
        <div class="reveal card card-hover border-glow p-7 flex flex-col">
          <span class="grid place-items-center h-12 w-12 rounded-xl bg-ink-800 border border-white/10 text-kesari-400"><Icon name={a.icon} size={22} /></span>
          <h3 class="mt-5 font-display text-lg font-semibold text-mist-100">{a.role}</h3>
          <p class="mt-2 text-sm leading-relaxed text-mist-400">{a.blurb}</p>
          <ul class="mt-5 space-y-2.5 flex-1">
            {a.proof.map((p) => (
              <li class="flex gap-2.5 text-sm text-mist-300"><span class="term-ok mono shrink-0">✔</span><span>{p}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="reveal mt-10 text-center text-sm sm:text-base text-mist-400 max-w-2xl mx-auto">
      Most candidates are strong in one of these lanes. Finding someone credible across <span class="text-mist-200">all three</span> — the people-manager, the hands-on engineer, and the compliance practitioner — is the rare part. That combination is what I bring.
    </p>
  </section>

  <!-- ===================== SOCIAL PROOF ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="What colleagues say" title="Trusted by the people he’s served" align="center" />
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {recommendations.map((r) => (
        <figure class="reveal card p-6 flex flex-col">
          <div class="text-kesari-500/40 font-display text-4xl leading-none">“</div>
          <blockquote class="-mt-2 text-sm leading-relaxed text-mist-300 flex-1">{r.text}</blockquote>
          <figcaption class="mt-5 pt-5 hairline">
            <a href={r.link} target="_blank" rel="noopener noreferrer" class="font-display text-sm font-semibold text-mist-100 hover:text-kesari-300 transition-colors">{r.name}</a>
            <p class="text-xs text-mist-500 mt-0.5">{r.title}</p>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="reveal mt-6 text-center">
      <a href={url('/about')} class="mono inline-flex items-center gap-2 text-sm font-medium text-kesari-300 hover:gap-3 transition-all">cd ./about — full story &amp; track record <Icon name="arrow" size={16} /></a>
    </div>
  </section>

  <!-- ===================== PRODUCTS ===================== -->
  <section class="container-x mt-28">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="I stay close to the work" title="Products from the lab">
        <p class="reveal mt-4 max-w-xl text-mist-400">I build the tools I’d want as a manager. It keeps me hands-on, honest about what I ask teams to do, and grounded in how the work actually feels.</p>
      </SectionHeading>
      <a href={url('/products')} class="reveal mono inline-flex items-center gap-2 text-sm font-medium text-kesari-300 hover:gap-3 transition-all">ls ./products <Icon name="arrow" size={16} /></a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {featured.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <!-- ===================== PRINCIPLES ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="How I work" title="Principles that hold across everything" align="center" />
    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {principles.map((p) => (
        <div class="reveal card card-hover p-7 flex gap-5">
          <span class="shrink-0 grid place-items-center h-12 w-12 rounded-xl bg-ink-800 border border-white/10 text-kesari-400">
            <Icon name={p.icon} size={22} />
          </span>
          <div>
            <h3 class="font-display text-lg font-semibold text-mist-100">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-mist-400">{p.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== SEVA TEASER ===================== -->
  <section class="container-x mt-28">
    <div class="turn relative card border-glow overflow-hidden p-8 sm:p-12">
      <Jali class="absolute inset-0 text-kesari-500/[0.08]" opacity={1} />
      <div class="relative grid lg:grid-cols-[1fr_auto] gap-8 items-center">
        <div>
          <p class="gurmukhi text-3xl text-kesari-400" lang="pa">ੴ</p>
          <h2 class="mt-3 font-display text-2xl sm:text-3xl font-semibold text-mist-100">The character behind the résumé</h2>
          <p class="mt-4 max-w-2xl text-mist-400 leading-relaxed">
            Beyond the work, I serve as a parcharik — speaking at community events worldwide and preserving Sikh heritage with
            <span class="text-mist-200"> Basics of Sikhi</span> and <span class="text-mist-200">Sikhi.io</span>.
            The code and the seva come from the same place: leadership rooted in service, resilience, and putting people first.
          </p>
          <a href={url('/seva')} class="mt-6 inline-flex items-center gap-2 rounded-xl glass px-5 py-3 font-semibold mono text-kesari-300 hover:border-kesari-500/40 transition-colors">
            cd ./seva <Icon name="arrow" size={18} />
          </a>
        </div>
        <Khanda size={140} class="hidden lg:block text-kesari-400/70 animate-float" />
      </div>
    </div>
  </section>

  <!-- ===================== FINAL CTA ===================== -->
  <section class="container-x mt-28">
    <div class="turn term">
      <div class="term-bar">
        <div class="term-lights" aria-hidden="true"><span class="term-light red"></span><span class="term-light amber"></span><span class="term-light green"></span></div>
        <span class="term-title">~/hire — jasvant</span>
        <span class="w-[3.4rem]" aria-hidden="true"></span>
      </div>
      <div class="term-body text-center py-12 sm:py-16">
        <p class="mono text-sm text-mist-500">$ ./contact --role "IT Manager"</p>
        <h2 class="mt-4 font-display text-3xl sm:text-4xl font-semibold text-mist-100 leading-tight">Hiring an IT Manager?</h2>
        <p class="mt-4 max-w-xl mx-auto text-mist-400 font-sans">Let’s talk about how I can lead your teams, deliver your programs, harden your posture, and run infrastructure that scales.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={url('/contact')} data-magnetic="0.35" class="inline-flex items-center gap-2 rounded-xl bg-kesari-500 text-ink-950 px-6 py-3.5 font-semibold mono hover:bg-kesari-400 transition-colors">./hire-me <Icon name="arrow" size={18} /></a>
          <a href={`${url('/contact')}#resumes`} data-magnetic="0.3" class="inline-flex items-center gap-2 rounded-xl glass px-5 py-3.5 font-semibold mono text-mist-200 hover:border-white/20 transition-colors"><Icon name="file" size={18} /> résumé.pdf</a>
        </div>
      </div>
    </div>
  </section>
</Base>
