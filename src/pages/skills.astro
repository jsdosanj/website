---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { skillGroups } from '../data/skills';
import { url } from '../utils';

const aiGroup = skillGroups.find((g) => g.wide)!;
const rest = skillGroups.filter((g) => !g.wide);
---
<Base title="Skills" description="The capabilities behind Dosanjh Labs — development with AI, strategic delivery, infrastructure, security, and engineering.">
  <section class="container-x pt-36 sm:pt-44">
    <div class="max-w-3xl">
      <p class="mono text-xs uppercase tracking-[0.22em] text-kesari-400 flex items-center gap-2 reveal is-visible">
        <span class="inline-block h-px w-6 bg-kesari-500/60"></span>Capabilities
      </p>
      <h1 class="reveal is-visible mt-4 font-display text-4xl sm:text-5xl font-bold tracking-tight text-mist-100">
        What I bring to the table.
      </h1>
      <p class="reveal is-visible mt-5 text-lg text-mist-400 leading-relaxed">
        A decade of running real infrastructure, leading programs, and — increasingly — building products with AI.
        I pair the discipline of compliance and delivery with the creativity to ship things that didn’t exist yesterday.
      </p>
    </div>
  </section>

  <!-- Featured: Development with AI -->
  <section class="container-x mt-14">
    <div class="reveal card border-glow relative overflow-hidden p-8 sm:p-10">
      <div class="absolute -right-10 -top-10 h-48 w-48 rounded-full bg-kesari-500/10 blur-3xl"></div>
      <div class="relative">
        <div class="flex items-center gap-3">
          <span class="grid place-items-center h-12 w-12 rounded-xl bg-kesari-500/15 border border-kesari-500/30 text-kesari-400"><Icon name="sparkles" size={24} /></span>
          <div>
            <h2 class="font-display text-2xl font-semibold text-mist-100">{aiGroup.title}</h2>
            <p class="mono text-[11px] uppercase tracking-wider text-kesari-400">my edge</p>
          </div>
        </div>
        <p class="mt-5 max-w-2xl text-mist-300 leading-relaxed">{aiGroup.blurb}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {aiGroup.skills.map((s) => (
            <span class="rounded-lg bg-kesari-500/10 border border-kesari-500/25 text-kesari-200 px-3 py-1.5 text-sm font-medium">{s}</span>
          ))}
        </div>
        <div class="mt-7 pt-6 hairline grid sm:grid-cols-3 gap-4 text-sm">
          <p class="text-mist-400"><span class="text-mist-100 font-medium">758M+ words</span> — corpus I built a custom OCR + RAG pipeline over.</p>
          <p class="text-mist-400"><span class="text-mist-100 font-medium">5 scripts</span> — Gurmukhi, Punjabi, Hindi, Urdu, Farsi handled end-to-end.</p>
          <p class="text-mist-400"><span class="text-mist-100 font-medium">Shipped, not slideware</span> — live on HuggingFace, used by real people.</p>
        </div>
        <a href={url('/products')} class="mt-7 inline-flex items-center gap-2 text-sm font-medium text-kesari-300 hover:gap-3 transition-all">See it in the products <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- Other skill groups -->
  <section class="container-x mt-8">
    <div class="grid gap-6 md:grid-cols-2">
      {rest.map((g) => (
        <div class="reveal card card-hover p-7">
          <div class="flex items-center gap-3">
            <span class="grid place-items-center h-11 w-11 rounded-xl bg-ink-800 border border-white/10 text-azure-400"><Icon name={g.icon} size={20} /></span>
            <h3 class="font-display text-lg font-semibold text-mist-100">{g.title}</h3>
          </div>
          <p class="mt-3 text-sm text-mist-400">{g.blurb}</p>
          <div class="mt-5 flex flex-wrap gap-1.5">
            {g.skills.map((s) => (
              <span class="mono text-[12px] text-mist-300 border border-white/10 rounded-md px-2.5 py-1 hover:border-azure-500/40 hover:text-azure-200 transition-colors">{s}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="container-x mt-24">
    <div class="reveal text-center">
      <h2 class="font-display text-3xl font-semibold text-mist-100">Curious how this maps to your team?</h2>
      <p class="mt-3 max-w-lg mx-auto text-mist-400">Let’s talk about where I can drive the most value.</p>
      <a href={url('/contact')} class="mt-7 inline-flex items-center gap-2 rounded-xl bg-kesari-500 text-ink-950 px-6 py-3.5 font-semibold hover:bg-kesari-400 transition-colors">Get in touch <Icon name="arrow" size={18} /></a>
    </div>
  </section>
</Base>
