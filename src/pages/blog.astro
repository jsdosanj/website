---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { posts } from '../data/posts';
import { site } from '../data/site';

const sorted = posts;
---
<Base
  title="Blog"
  description="Writing and LinkedIn posts from Jasvant Singh Dosanjh on AI, OCR, IT leadership, and Sikh heritage technology."
  keywords={["Jasvant Dosanjh blog", "AI writing", "Sikh technology blog", "LinkedIn posts"]}
>
  <section class="container-x pt-36 sm:pt-44">
    <div class="max-w-3xl">
      <p class="mono text-xs uppercase tracking-[0.22em] text-kesari-400 flex items-center gap-2 reveal is-visible">
        <span class="inline-block h-px w-6 bg-kesari-500/60"></span>Writing & posts
      </p>
      <h1 class="reveal is-visible mt-4 font-display text-4xl sm:text-5xl font-bold tracking-tight text-mist-100">
        Notes from the <span class="text-kesari-gradient">journey.</span>
      </h1>
      <p class="reveal is-visible mt-5 text-lg text-mist-400 leading-relaxed">
        Thoughts on AI, infrastructure, building tools that help, and carrying heritage forward —
        shared here and on LinkedIn. Follow along for the latest.
      </p>
      <a href={site.socials.linkedin} target="_blank" rel="noopener noreferrer" class="reveal is-visible mt-6 inline-flex items-center gap-2 rounded-xl bg-kesari-500 text-ink-950 px-5 py-3 font-semibold hover:bg-kesari-400 transition-colors">
        <Icon name="linkedin" size={18} /> Follow on LinkedIn
      </a>
    </div>
  </section>

  <section class="container-x mt-14">
    {sorted.length === 0 ? (
      <div class="reveal card p-10 text-center text-mist-400">No posts yet — check back soon.</div>
    ) : (
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {sorted.map((p) => (
          <a href={p.url} target="_blank" rel="noopener noreferrer" class="reveal card card-hover border-glow p-6 flex flex-col group">
            <div class="flex items-center justify-between gap-3">
              <span class="mono text-[11px] uppercase tracking-wider text-kesari-400">{p.category}</span>
              <span class="mono text-[11px] text-mist-500">{p.date}</span>
            </div>
            <h2 class="mt-3 font-display text-lg font-semibold text-mist-100 group-hover:text-kesari-200 transition-colors">{p.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-mist-400 flex-1">{p.excerpt}</p>
            <div class="mt-5 flex flex-wrap items-center gap-1.5">
              {p.tags.map((t) => (
                <span class="mono text-[11px] text-mist-400 border border-white/10 rounded-md px-2 py-1">{t}</span>
              ))}
              <span class="ml-auto inline-flex items-center gap-1.5 text-sm font-medium text-kesari-300">
                <Icon name="linkedin" size={14} /> Read
              </span>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="container-x mt-20">
    <div class="reveal card p-6 sm:p-7 text-sm text-mist-500 flex items-start gap-3">
      <Icon name="sparkles" size={18} class="text-kesari-500/70 shrink-0 mt-0.5" />
      <p>
        Want a post featured here? Add it in <code class="mono text-xs bg-ink-700 text-mist-200 px-1.5 py-0.5 rounded">src/data/posts.ts</code>
        with its LinkedIn link — or use LinkedIn’s “Embed this post” option to embed it directly.
      </p>
    </div>
  </section>
</Base>
