---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Khanda from '../components/Khanda.astro';
import { url } from '../utils';
---
<Base title="Page not found" description="404 — that path doesn't exist on this site." noindex={true}>
  <section class="container-x pt-44 sm:pt-52 pb-24 text-center">
    <Khanda size={64} class="mx-auto text-kesari-400 animate-float" />
    <p class="mt-6 font-display text-7xl sm:text-8xl font-bold text-kesari-gradient leading-none">404</p>
    <div class="reveal is-visible mt-8 max-w-md mx-auto term text-left">
      <div class="term-bar">
        <div class="term-lights" aria-hidden="true"><span class="term-light red"></span><span class="term-light amber"></span><span class="term-light green"></span></div>
        <span class="term-title">jasvant@portfolio — zsh</span>
        <span class="w-[3.4rem]" aria-hidden="true"></span>
      </div>
      <div class="term-body">
        <p><span class="term-user">jasvant@portfolio</span> <span class="term-prompt-sym">~ %</span> cd {Astro.url.pathname}</p>
        <p class="text-mac-red">cd: no such file or directory: {Astro.url.pathname}</p>
        <p class="mt-3 term-comment">$ ls /</p>
        <p class="mt-1">
          <a href={url('/')} class="text-kesari-300 underline underline-offset-2 hover:text-kesari-200">home</a>{'  '}
          <a href={url('/about')} class="text-kesari-300 underline underline-offset-2 hover:text-kesari-200">about</a>{'  '}
          <a href={url('/products')} class="text-kesari-300 underline underline-offset-2 hover:text-kesari-200">products</a>{'  '}
          <a href={url('/contact')} class="text-kesari-300 underline underline-offset-2 hover:text-kesari-200">contact</a>
        </p>
      </div>
    </div>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={url('/')} class="inline-flex items-center gap-2 rounded-xl bg-kesari-500 text-ink-950 px-5 py-3 font-semibold hover:bg-kesari-400 transition-colors">
        <Icon name="arrow" size={18} class="rotate-180" /> Back home
      </a>
      <a href={url('/products')} class="inline-flex items-center gap-2 rounded-xl glass px-5 py-3 font-semibold text-mist-200 hover:border-white/20 transition-colors">View products</a>
      <a href={url('/contact')} class="inline-flex items-center gap-2 rounded-xl glass px-5 py-3 font-semibold text-mist-200 hover:border-white/20 transition-colors">Get in touch</a>
    </div>
  </section>
</Base>
