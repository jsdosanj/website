---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Khanda from '../components/Khanda.astro';
import { nav } from '../data/site';
import { url } from '../utils';
---
<Base title="Page not found" description="404 — that page doesn't exist on this site." noindex={true}>
  <section class="container-x pt-44 sm:pt-52 pb-24 text-center">
    <Khanda size={64} class="mx-auto text-kesari-500 animate-float" />
    <p class="mt-6 type-display-1 text-kesari-gradient">404</p>
    <h1 class="mt-4 type-title-2 text-navy-900">This page doesn’t exist.</h1>
    <p class="mt-3 max-w-md mx-auto text-ink-600">
      The address <span class="type-mono-inline text-navy-800 break-all">{Astro.url.pathname}</span> isn’t part of this site.
      Everything that is, is one click away.
    </p>

    <nav class="reveal is-visible mt-8 max-w-lg mx-auto" aria-label="Site sections">
      <ul class="flex flex-wrap justify-center gap-2" role="list">
        {nav.map((item) => (
          <li>
            <a href={url(item.href)} class="inline-flex items-center min-h-11 rounded-lg border border-navy-800/14 px-4 type-subhead font-medium text-ink-700 hover:text-navy-900 hover:border-navy-800/30 transition-colors btn-press">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={url('/')} class="btn btn-primary">
        <Icon name="arrow" size={18} class="rotate-180" /> Back home
      </a>
      <a href={url('/work')} class="btn btn-secondary">View case studies</a>
    </div>
  </section>
</Base>
