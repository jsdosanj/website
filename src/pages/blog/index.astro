---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { posts as linkedinPosts } from '../../data/posts';
import { url } from '../../utils';

// On-site essays. Add future posts here — newest first.
const essays = [
  {
    title: "The AI race just fractured — and the US did it to itself",
    href: "/blog/the-ai-race-just-fractured",
    date: "June 22, 2026",
    dek: "The US banned its own best models, Japan matched frontier benchmarks without a single frontier model, and China’s open-weight stack is closing fast. The AI landscape from two weeks ago is already gone.",
  },
  {
    title: "AI just became a single point of failure — the fix is local",
    href: "/blog/the-future-of-ai-runs-on-your-device",
    date: "June 13, 2026",
    dek: "The U.S. government switched off the most powerful AI model on Earth overnight. Here’s why that’s the strongest argument yet for running AI you actually own.",
  },
];

const postsUrl = `${site.socials.linkedin}/recent-activity/all/`;
---
<Base
  title="Writing — AI, Security & GRC Essays"
  description="Essays by Jasvant Singh Dosanjh on AI, security, GRC, and building local-first, privacy-respecting software — plus recent posts on LinkedIn."
  keywords={["Jasvant Dosanjh blog", "local AI", "GRC writing", "privacy-respecting software", "security essays"]}
  ogImage="/og/blog.png"
>
  <!-- ===================== HERO ===================== -->
  <section class="relative pt-36 sm:pt-48 pb-4 overflow-hidden">
    <div class="absolute left-1/2 -translate-x-1/2 top-20 h-80 w-80 rounded-full bg-kesari-500/10 blur-[100px]"></div>
    <div class="container-x relative">
      <p class="reveal is-visible eyebrow">Writing</p>
      <h1 class="mt-4 font-display text-4xl sm:text-5xl font-bold tracking-tight text-navy-900" data-kinetic>
        <span class="kin-line"><span class="kin-inner">Notes on AI, security &amp; building things that last</span></span>
      </h1>
      <p class="reveal mt-4 max-w-2xl text-ink-600 leading-relaxed">
        Occasional essays on local-first AI, resilience and compliance, and the craft of building
        software people can actually trust.
      </p>
    </div>
  </section>

  <!-- ===================== ESSAYS ===================== -->
  <section class="container-x mt-12 sm:mt-14">
    <ul class="space-y-5 max-w-3xl" role="list">
      {essays.map((p) => (
        <li class="reveal">
          <a href={url(p.href)} class="group block card card-hover border-glow p-6 sm:p-7">
            <span class="mono text-[11px] uppercase tracking-wider text-kesari-700">{p.date}</span>
            <h2 class="mt-2 font-display text-xl sm:text-2xl font-semibold text-navy-900 leading-snug group-hover:text-kesari-700 transition-colors">{p.title}</h2>
            <p class="mt-3 text-sm sm:text-[15px] leading-relaxed text-ink-600">{p.dek}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-kesari-700">Read the post <Icon name="arrow" size={16} /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ===================== LINKEDIN POSTS ===================== -->
  <section class="container-x mt-24">
    <SectionHeading eyebrow="From LinkedIn" title="More short-form posts">
      <p class="reveal mt-4 max-w-2xl text-ink-600 leading-relaxed">
        I share most of my day-to-day thinking on LinkedIn — from AI and cybersecurity to heritage and seva.
        Here are a few recent ones.
      </p>
    </SectionHeading>

    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {linkedinPosts.map((p) => (
        <a href={p.url} target="_blank" rel="noopener noreferrer" class="reveal card card-hover border-glow p-6 flex flex-col group">
          <div class="flex items-center justify-between gap-3">
            <span class="mono text-[11px] uppercase tracking-wider text-kesari-700">{p.category}</span>
            <span class="mono text-[11px] text-ink-500">{p.date}</span>
          </div>
          <h3 class="mt-3 font-display text-lg font-semibold text-navy-900 group-hover:text-kesari-700 transition-colors">{p.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-600 flex-1">{p.excerpt}</p>
          <div class="mt-5 flex flex-wrap items-center gap-1.5">
            {p.tags.map((t) => (
              <span class="mono text-[11px] text-ink-600 border border-navy-800/12 rounded-md px-2 py-1">{t}</span>
            ))}
            <span class="ml-auto inline-flex items-center gap-1.5 text-sm font-medium text-kesari-700">
              <Icon name="linkedin" size={14} /> Read
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="reveal mt-10 text-center">
      <a href={postsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 rounded-xl bg-kesari-500 text-navy-950 px-6 py-3.5 font-semibold hover:bg-kesari-400 transition-colors">
        <Icon name="linkedin" size={18} /> See all my posts on LinkedIn <Icon name="arrow" size={18} />
      </a>
    </div>
  </section>
</Base>
