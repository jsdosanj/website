---
// Case-study section. PM screening turns on how a program is narrated, so each
// study is laid out in the order an interviewer probes: situation, scope,
// stakeholders, plan, risks, what went wrong, outcome, retro.
//
// One page rather than one page per study: a hiring manager reads these in a
// single sitting, and three studies at this depth is a comfortable read while
// three separate pages would bury two of them.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { caseStudies } from '../data/caseStudies';
import { site } from '../data/site';
import { url } from '../utils';

const statusChip = { delivered: 'chip-delivered', active: 'chip-active', recovered: 'chip-recovered' } as const;
const statusLabel = { delivered: 'Delivered', active: 'In flight', recovered: 'Recovered' } as const;

const jsonld = caseStudies.map((c) => ({
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${site.url}/work#${c.slug}`,
  headline: c.title,
  description: c.summary,
  author: { '@id': `${site.url}/#person` },
  about: c.org,
}));
---
<Base
  title="Case Studies — Programs Delivered"
  description="Three programs delivered by Jasvant Singh Dosanjh at interview depth: an escalated clinical IT rescue, a zero-to-one gaming studio buildout, and a 15,000-student district rollout in eight weeks."
  keywords={['program management case study', 'technical program manager portfolio', 'project management case study', 'stakeholder management', 'risk register', 'delivery plan', 'PM case study']}
  jsonld={jsonld}
  ogImage="/og/work.png"
>
  <!-- ===================== HERO ===================== -->
  <section class="container-x pt-36 sm:pt-44">
    <div class="max-w-3xl">
      <p class="eyebrow reveal is-visible">Case studies</p>
      <h1 class="mt-4 type-display-2 text-navy-900" data-kinetic>
        <span class="kin-line"><span class="kin-inner">Three programs, start to finish.</span></span>
      </h1>
      <p class="reveal is-visible mt-5 type-body text-ink-600 leading-relaxed">
        A card can tell you a program shipped. It can’t tell you how it was scoped, who had to be moved, what was
        actually at risk, or what went wrong — which is the part worth interviewing about. So here are three at the
        depth I’d discuss them in a room, including the parts I got wrong first.
      </p>
    </div>

    <!-- Index -->
    <nav class="reveal is-visible mt-10 grid gap-3 sm:grid-cols-3" aria-label="Case studies">
      {caseStudies.map((c, i) => (
        <a href={`#${c.slug}`} class="card card-hover p-5 flex flex-col group">
          <div class="flex items-center justify-between gap-3">
            <span class="type-mono-sm font-semibold text-ink-400">{String(i + 1).padStart(2, '0')}</span>
            <span class:list={['chip', statusChip[c.status]]}>{statusLabel[c.status]}</span>
          </div>
          <h2 class="mt-3 font-display type-subhead font-semibold text-navy-900 leading-snug flex-1">{c.title}</h2>
          <p class="mt-2 type-caption text-navy-600">{c.org}</p>
          <span class="mt-3 inline-flex items-center gap-1.5 type-footnote font-semibold text-navy-700 group-hover:gap-2.5 transition-all">
            Read <Icon name="arrow" size={14} />
          </span>
        </a>
      ))}
    </nav>
  </section>

  <!-- ===================== STUDIES ===================== -->
  {caseStudies.map((c, i) => (
    <section id={c.slug} class="container-x mt-24 sm:mt-28 scroll-mt-28">
      <article class="card overflow-hidden">
        <!-- Study header -->
        <header class="px-6 py-6 sm:px-8 sm:py-8 border-b border-navy-800/10 bg-paper-200/50">
          <div class="flex flex-wrap items-center gap-3">
            <span class="type-mono-sm font-semibold text-ink-400">CASE {String(i + 1).padStart(2, '0')}</span>
            <span class:list={['chip', statusChip[c.status]]}>{statusLabel[c.status]}</span>
            <span class="type-mono-sm text-ink-500">{c.date}</span>
          </div>
          <h2 class="mt-3 type-title-2 text-navy-900">{c.title}</h2>
          <p class="mt-2 type-subhead font-medium text-navy-600">{c.org}</p>
          <p class="mt-1 type-mono-sm text-ink-500">{c.role}</p>
          <p class="mt-5 max-w-3xl type-subhead leading-relaxed text-ink-700">{c.summary}</p>

          <!-- Metric strip -->
          <dl class="mt-6 grid grid-cols-2 lg:grid-cols-4 gap-px rounded-xl overflow-hidden border border-navy-800/10 bg-navy-900/[0.06]">
            {c.metrics.map((m) => (
              <div class="bg-paper-50 px-4 py-3.5">
                <dd class="type-metric">{m.value}</dd>
                <dt class="mt-1.5 type-caption leading-snug text-ink-600">{m.label}</dt>
              </div>
            ))}
          </dl>
        </header>

        <div class="px-6 py-8 sm:px-8 sm:py-10 space-y-10">
          <!-- Situation -->
          <div>
            <h3 class="eyebrow">Situation inherited</h3>
            <p class="mt-3 max-w-3xl type-subhead leading-relaxed text-ink-700">{c.situation}</p>
          </div>

          <!-- Scope -->
          <div>
            <h3 class="eyebrow">Scope</h3>
            <div class="mt-4 grid gap-5 md:grid-cols-2">
              <div class="rounded-xl border border-navy-800/10 bg-paper-200/50 p-5">
                <p class="type-label font-semibold text-status-green">In scope</p>
                <ul class="mt-3 space-y-2">
                  {c.scope.inScope.map((x) => (
                    <li class="flex gap-2.5 type-footnote leading-relaxed text-ink-700">
                      <span class="mt-[7px] h-1 w-1 rounded-full bg-status-green shrink-0"></span><span>{x}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="rounded-xl border border-navy-800/10 bg-paper-200/50 p-5">
                <p class="type-label font-semibold text-ink-400">Explicitly out of scope</p>
                <ul class="mt-3 space-y-2">
                  {c.scope.outOfScope.map((x) => (
                    <li class="flex gap-2.5 type-footnote leading-relaxed text-ink-600">
                      <span class="mt-[7px] h-1 w-1 rounded-full bg-ink-400 shrink-0"></span><span>{x}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <!-- Stakeholders -->
          <div>
            <h3 class="eyebrow">Stakeholder map</h3>
            <div class="mt-4 overflow-x-auto">
              <table class="w-full text-left min-w-[30rem]">
                <caption class="sr-only">Stakeholder groups and what each needed from the program</caption>
                <thead>
                  <tr class="type-label text-ink-400">
                    <th scope="col" class="font-medium pb-2 pr-6">Group</th>
                    <th scope="col" class="font-medium pb-2">What they needed</th>
                  </tr>
                </thead>
                <tbody>
                  {c.stakeholders.map((sh) => (
                    <tr class="border-t border-navy-800/[0.08]">
                      <th scope="row" class="py-3 pr-6 align-top type-footnote font-semibold text-navy-900 md:whitespace-nowrap">{sh.group}</th>
                      <td class="py-3 align-top type-footnote leading-relaxed text-ink-700">{sh.need}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Plan -->
          <div>
            <h3 class="eyebrow">How it was sequenced</h3>
            <ol class="mt-4 space-y-3">
              {c.plan.map((ph) => (
                <li class="rounded-xl border border-navy-800/10 bg-paper-200/40 p-4 sm:p-5">
                  <p class="font-display type-subhead font-semibold text-navy-900">{ph.phase}</p>
                  <p class="mt-1.5 type-footnote leading-relaxed text-ink-700">{ph.detail}</p>
                </li>
              ))}
            </ol>
          </div>

          <!-- Risks -->
          <div>
            <h3 class="eyebrow">Risk register</h3>
            <div class="mt-4 overflow-x-auto">
              <table class="w-full text-left min-w-[32rem]">
                <caption class="sr-only">Risks identified and how each was mitigated</caption>
                <thead>
                  <tr class="type-label text-ink-400">
                    <th scope="col" class="font-medium pb-2 pr-6 w-1/2">Risk</th>
                    <th scope="col" class="font-medium pb-2">Mitigation</th>
                  </tr>
                </thead>
                <tbody>
                  {c.risks.map((r) => (
                    <tr class="border-t border-navy-800/[0.08]">
                      <th scope="row" class="py-3 pr-6 align-top type-footnote font-normal leading-relaxed text-navy-900">{r.risk}</th>
                      <td class="py-3 align-top type-footnote leading-relaxed text-ink-700">{r.mitigation}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- What went wrong -->
          <div class="rounded-xl border border-kesari-500/35 bg-kesari-500/[0.07] p-5 sm:p-6">
            <h3 class="type-label font-semibold text-kesari-700">What went wrong</h3>
            <p class="mt-2.5 max-w-3xl type-subhead leading-relaxed text-ink-800">{c.wentWrong}</p>
          </div>

          <!-- Outcome -->
          <div>
            <h3 class="eyebrow">Outcome</h3>
            <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
              {c.outcome.map((o) => (
                <li class="flex gap-2.5 type-footnote leading-relaxed text-ink-700">
                  <Icon name="arrow" size={14} class="mt-1 text-kesari-600 shrink-0" /><span>{o}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Retro -->
          <div class="pt-6 hairline">
            <h3 class="eyebrow">What I'd do differently</h3>
            <p class="mt-3 max-w-3xl type-subhead leading-relaxed text-ink-700">{c.retro}</p>
          </div>
        </div>
      </article>
    </section>
  ))}

  <!-- ===================== CTA ===================== -->
  <section class="container-x mt-24">
    <div class="card border-glow overflow-hidden">
      <div class="text-center px-6 py-12 sm:px-10 sm:py-16">
        <SectionHeading eyebrow="Next" title="Want the version with follow-up questions?" align="center">
          <p class="reveal mt-4 max-w-xl mx-auto text-ink-600">
            These are the written versions. The interesting parts are the ones you'd ask about — happy to walk through any of them.
          </p>
        </SectionHeading>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={url('/contact')} data-magnetic="0.3" class="btn btn-primary">Let’s talk <Icon name="arrow" size={18} /></a>
          <a href={url('/about')} class="btn btn-secondary">Full track record</a>
        </div>
      </div>
    </div>
  </section>
</Base>
