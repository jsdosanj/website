---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Khanda from '../components/Khanda.astro';
import Jali from '../components/Jali.astro';
import { site } from '../data/site';

const channels = [
  { icon: 'linkedin', label: 'LinkedIn', value: 'in/jasvantsd', href: site.socials.linkedin, note: 'Best way to reach me' },
  { icon: 'github', label: 'GitHub', value: 'jsdosanj', href: site.socials.github, note: 'Code & projects' },
];
---
<Base title="Contact" description="Get in touch with Jasvant Singh Dosanjh — open to IT Security & GRC Leader, Technical Program Manager, and Senior Systems & Endpoint Engineer roles.">
  <section class="relative pt-36 sm:pt-48 overflow-hidden">
    <Jali class="absolute inset-0 text-azure-500/[0.08]" opacity={1} />
    <div class="container-x relative">
      <div class="text-center max-w-2xl mx-auto">
        <Khanda size={56} class="mx-auto text-kesari-400 animate-float" />
        <span class="reveal is-visible inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3.5 py-1.5 text-xs font-medium text-emerald-300">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse-glow"></span>
          Open to new roles · Seattle / Remote
        </span>
        <h1 class="reveal is-visible mt-5 font-display text-4xl sm:text-5xl font-bold tracking-tight text-mist-100">Let’s connect.</h1>
        <p class="reveal is-visible mt-5 text-lg text-mist-400 leading-relaxed">
          I’m actively interviewing for <span class="text-mist-200">IT Security &amp; GRC Leader</span>, <span class="text-mist-200">Technical Program Manager</span>, and <span class="text-mist-200">Senior Systems &amp; Endpoint Engineer</span> roles —
          and always happy to talk infrastructure, AI, or a tool worth building. If you’re hiring, let’s find 20 minutes.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 max-w-3xl mx-auto">
        {channels.map((c) => (
          <a href={c.href} target={c.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener noreferrer" class="reveal card card-hover border-glow p-6 flex items-center gap-4 group">
            <span class="grid place-items-center h-12 w-12 rounded-xl bg-ink-800 border border-white/10 text-kesari-400 group-hover:scale-105 transition-transform"><Icon name={c.icon} size={22} /></span>
            <div class="min-w-0">
              <p class="font-display text-base font-semibold text-mist-100">{c.label}</p>
              <p class="mono text-sm text-mist-400 truncate">{c.value}</p>
              <p class="text-[11px] text-mist-500 mt-0.5">{c.note}</p>
            </div>
            <Icon name="arrow" size={18} class="ml-auto text-mist-500 group-hover:text-kesari-300 group-hover:translate-x-0.5 transition-all" />
          </a>
        ))}
      </div>

      <!-- Résumés — role-tailored, single page, ATS-friendly -->
      <div class="mt-14 max-w-3xl mx-auto">
        <p class="reveal text-center mono text-xs uppercase tracking-[0.22em] text-kesari-400">Résumés — pick the role you’re hiring for</p>
        <div class="reveal mt-5 grid gap-3 sm:grid-cols-2">
          {site.resumes.map((r) => (
            <a href={r.href} download class="card card-hover p-4 flex items-center gap-3 group">
              <span class="grid place-items-center h-10 w-10 rounded-lg bg-ink-800 border border-white/10 text-kesari-400 shrink-0"><Icon name="file" size={18} /></span>
              <span class="font-display text-sm font-semibold text-mist-100 group-hover:text-kesari-200 transition-colors">{r.label}</span>
              <Icon name="arrow" size={16} class="ml-auto text-mist-500 group-hover:text-kesari-300 transition-colors" />
            </a>
          ))}
        </div>
        <p class="reveal mt-4 text-center text-xs text-mist-500">Each is a single-page, ATS-friendly résumé tailored to that role.</p>
      </div>

    </div>
  </section>
</Base>
