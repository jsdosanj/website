---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Khanda from '../components/Khanda.astro';
import Jali from '../components/Jali.astro';
import { site } from '../data/site';

const channels = [
  { icon: 'linkedin', label: 'LinkedIn', value: 'in/jasvantsd', href: site.socials.linkedin, note: 'Best way to reach me' },
  { icon: 'github', label: 'GitHub', value: 'jsdosanj', href: site.socials.github, note: 'Code & projects' },
];
---
<Base title="Contact — Hire an IT Manager" description="Get in touch with Jasvant Singh Dosanjh — IT Manager open to relocating, open to IT Manager, IT Program / Project Manager, and IT Security & GRC Leader roles." ogImage="/og/contact.png">
  <section class="relative pt-36 sm:pt-48 overflow-hidden">
    <Jali class="absolute inset-0 text-azure-500/[0.08]" opacity={1} />
    <div class="container-x relative">
      <div class="text-center max-w-2xl mx-auto">
        <Khanda size={56} class="mx-auto text-kesari-400 animate-float" />
        <span class="reveal is-visible inline-flex items-center gap-2 rounded-full border border-phos-400/30 bg-phos-400/10 px-3.5 py-1.5 text-xs font-medium mono text-phos-300">
          <span class="h-2 w-2 rounded-full bg-phos-400 animate-pulse-glow"></span>
          open to work · remote / open to relocating
        </span>
        <p class="reveal is-visible mt-5 mono text-sm text-mist-500">$ ./contact --role "IT Manager"</p>
        <h1 class="mt-3 font-display text-4xl sm:text-5xl font-bold tracking-tight text-mist-100" data-kinetic>
          <span class="kin-line"><span class="kin-inner">Let’s connect.</span></span>
        </h1>
        <p class="reveal is-visible mt-5 text-lg text-mist-400 leading-relaxed">
          I’m actively interviewing for <span class="text-mist-200">IT Manager</span>, <span class="text-mist-200">IT Program / Project Manager</span>, and <span class="text-mist-200">IT Security &amp; GRC Leader</span> roles —
          and always happy to talk infrastructure, AI, or a tool worth building. If you’re hiring, let’s find 20 minutes.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 max-w-3xl mx-auto">
        {channels.map((c) => (
          <a href={c.href} target={c.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener noreferrer" class="reveal card card-hover border-glow p-6 flex items-center gap-4 group">
            <span class="grid place-items-center h-12 w-12 rounded-xl bg-ink-800 border border-white/10 text-kesari-400 group-hover:scale-105 transition-transform"><Icon name={c.icon} size={22} /></span>
            <div class="min-w-0">
              <p class="font-display text-base font-semibold text-mist-100">{c.label}</p>
              <p class="mono text-sm text-mist-400 truncate">{c.value}</p>
              <p class="text-[11px] text-mist-500 mt-0.5">{c.note}</p>
            </div>
            <Icon name="arrow" size={18} class="ml-auto text-mist-500 group-hover:text-kesari-300 group-hover:translate-x-0.5 transition-all" />
          </a>
        ))}
      </div>

      <!-- Résumés — role-tailored, 2-page, ATS-friendly -->
      <div id="resumes" class="mt-14 max-w-3xl mx-auto scroll-mt-28">
        <p class="reveal text-center mono text-xs uppercase tracking-[0.22em] text-kesari-400">Résumés — pick the role you’re hiring for</p>
        <div class="reveal mt-5 grid gap-3 sm:grid-cols-2">
          {site.resumes.map((r) => (
            <a href={r.href} download class="card card-hover p-4 flex items-center gap-3 group">
              <span class="grid place-items-center h-10 w-10 rounded-lg bg-ink-800 border border-white/10 text-kesari-400 shrink-0"><Icon name="file" size={18} /></span>
              <span class="font-display text-sm font-semibold text-mist-100 group-hover:text-kesari-200 transition-colors">{r.label}</span>
              <Icon name="arrow" size={16} class="ml-auto text-mist-500 group-hover:text-kesari-300 transition-colors" />
            </a>
          ))}
        </div>
        <p class="reveal mt-4 text-center text-xs text-mist-500">Each is a 2-page, ATS-friendly résumé tailored to that role.</p>
      </div>

      <!-- Contact form — FormSubmit (email never appears in source) -->
      <div class="mt-16 max-w-2xl mx-auto">
        <p class="reveal text-center mono text-xs uppercase tracking-[0.22em] text-kesari-400">Or send a message</p>
        <h2 class="reveal mt-3 text-center font-display text-2xl sm:text-3xl font-bold tracking-tight text-mist-100">Drop me a line.</h2>
        <p class="reveal mt-3 text-center text-sm text-mist-400">Tell me about the role, the team, or the problem you’re trying to solve. I read every message.</p>

        <div id="ok" hidden class="reveal mt-6 flex items-start gap-3 rounded-xl border border-phos-400/30 bg-phos-400/10 px-5 py-4 text-phos-300">
          <span class="mt-0.5 grid place-items-center h-6 w-6 rounded-full bg-phos-400/20 text-phos-300 shrink-0"><Icon name="arrow" size={16} /></span>
          <div>
            <p class="font-display text-sm font-semibold text-phos-300">Thanks — your message is on its way.</p>
            <p class="text-xs text-phos-300/80 mt-0.5">I’ll get back to you as soon as I can.</p>
          </div>
        </div>

        <form id="cf" method="POST" data-e="ZG90cy13aGlza3MuNnJAaWNsb3VkLmNvbQ==" class="reveal card border-glow p-6 sm:p-8 mt-6 grid gap-5">
          <input type="hidden" name="_subject" value="New message from jasvant.dosanjhlabs.com" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value="https://jasvant.dosanjhlabs.com/contact?sent=1" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="grid gap-2">
            <label for="cf-name" class="font-display text-xs font-medium uppercase tracking-wider text-mist-300">Name <span class="text-kesari-400">*</span></label>
            <input
              id="cf-name" name="name" type="text" required autocomplete="name"
              placeholder="Your name"
              class="w-full rounded-lg bg-ink-800 border border-white/10 px-4 py-3 text-sm text-mist-100 placeholder:text-mist-500 transition-colors focus:border-kesari-500/50 focus:outline-none focus:ring-1 focus:ring-kesari-500/40"
            />
          </div>

          <div class="grid gap-2">
            <label for="cf-email" class="font-display text-xs font-medium uppercase tracking-wider text-mist-300">Email <span class="text-kesari-400">*</span></label>
            <input
              id="cf-email" name="email" type="email" required autocomplete="email"
              placeholder="you@example.com"
              class="w-full rounded-lg bg-ink-800 border border-white/10 px-4 py-3 text-sm text-mist-100 placeholder:text-mist-500 transition-colors focus:border-kesari-500/50 focus:outline-none focus:ring-1 focus:ring-kesari-500/40"
            />
          </div>

          <div class="grid gap-2">
            <label for="cf-company" class="font-display text-xs font-medium uppercase tracking-wider text-mist-300">Company / Organization <span class="text-mist-500 normal-case tracking-normal">(optional)</span></label>
            <input
              id="cf-company" name="company" type="text" autocomplete="organization"
              placeholder="Where you’re reaching out from"
              class="w-full rounded-lg bg-ink-800 border border-white/10 px-4 py-3 text-sm text-mist-100 placeholder:text-mist-500 transition-colors focus:border-kesari-500/50 focus:outline-none focus:ring-1 focus:ring-kesari-500/40"
            />
          </div>

          <div class="grid gap-2">
            <label for="cf-message" class="font-display text-xs font-medium uppercase tracking-wider text-mist-300">Message <span class="text-kesari-400">*</span></label>
            <textarea
              id="cf-message" name="message" required rows="5"
              placeholder="What’s on your mind?"
              class="w-full rounded-lg bg-ink-800 border border-white/10 px-4 py-3 text-sm text-mist-100 placeholder:text-mist-500 transition-colors resize-y focus:border-kesari-500/50 focus:outline-none focus:ring-1 focus:ring-kesari-500/40"
            ></textarea>
          </div>

          <button
            type="submit"
            data-magnetic="0.25"
            class="group inline-flex items-center justify-center gap-2 rounded-lg bg-kesari-500 px-6 py-3 font-display text-sm font-semibold text-ink-950 transition-all hover:bg-kesari-400 hover:shadow-[0_12px_40px_-12px_var(--color-kesari-500)]"
          >
            Send message
            <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-0.5" />
          </button>
        </form>
      </div>

    </div>
  </section>

  <script is:inline>
    (function(){try{var f=document.getElementById('cf');f.action='https://formsubmit.co/'+atob(f.getAttribute('data-e'));}catch(e){}})();
    if(location.search.indexOf('sent=1')>=0){var o=document.getElementById('ok'),f=document.getElementById('cf');if(o)o.hidden=false;if(f)f.style.display='none';}
  </script>
</Base>
