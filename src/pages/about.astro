---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import Portrait from '../components/Portrait.astro';
import JourneyTrail from '../components/JourneyTrail.astro';
import ProgramRoadmap from '../components/ProgramRoadmap.astro';
import { leadership } from '../data/leadership';
import { education, certifications } from '../data/education';
import { recommendations } from '../data/recommendations';
import { journeyCreed } from '../data/journey';
import { headlineProjects, moreProjects } from '../data/projectsLed';
import { products } from '../data/products';
import { site } from '../data/site';
import { url } from '../utils';

const sikhiProjects = products.filter((p) => p.accent === 'kesari');
const ossProjects = products.filter((p) => p.openSource);
const showcaseTabs = [
  { id: 'sikhi', label: 'sikhi & heritage', items: sikhiProjects },
  { id: 'oss', label: 'open-source', items: ossProjects },
];

// "How I work" as the register a PM actually keeps, rather than a grid of
// abstract values. Each entry pairs the operating rule with a real program
// from the track record, so the claim is checkable.
const raid = [
  {
    key: 'R',
    heading: 'Risks',
    rule: 'Surfaced in week two, not week ten.',
    text: 'A risk raised early is a scheduling conversation; the same risk raised late is an apology. I would rather give a later date I can hold than an early one that slips twice — and I would rather be the one who names the problem.',
    evidence: 'Sequenced a six-month, multi-building security migration building by building specifically so a failure could never take the whole college down. Zero downtime.',
  },
  {
    key: 'A',
    heading: 'Assumptions',
    rule: 'Written down, then re-tested.',
    text: 'Most slipped programs were scoped on an assumption nobody wrote down. I put them on the page where stakeholders can disagree with them early, and I revisit them when the ground moves.',
    evidence: 'Forecast a $250K annual hardware program with department heads rather than for them — so the device counts were their numbers, aligned to their budgets, before a PO was raised.',
  },
  {
    key: 'I',
    heading: 'Issues',
    rule: 'Owned by a name, not a team.',
    text: 'Work assigned to "IT" is work nobody has picked up. Every open issue gets a person and a date, and the dispatch is visible enough that the team can hold each other to it.',
    evidence: 'Stepping into a three-month leadership vacancy, established formal ticket-dispatch accountability across a 9-person team — including 4 union civil-service staff — and service never dropped.',
  },
  {
    key: 'D',
    heading: 'Dependencies',
    rule: 'Mapped before the date is given.',
    text: 'The vendor who needs four weeks, the clinician who is only free on Tuesdays, the approval that takes a committee — those set the critical path, not the engineering estimate. I find them first.',
    evidence: 'Coordinated five healthcare vendors, clinicians, and infrastructure stakeholders through a HIPAA clinic onboarding, taking the SLA from 48 hours to 2 and cutting $30K a year.',
  },
];

// RAG status presentation for the program cards. "Recovered" is called out
// separately from "Delivered" because a program that arrived escalated and
// ended green is a different (harder) claim than one that was never red.
const statusChip = {
  delivered: 'chip-delivered',
  active: 'chip-active',
  recovered: 'chip-recovered',
} as const;
const statusLabel = {
  delivered: 'Delivered',
  active: 'In flight',
  recovered: 'Recovered',
} as const;

const philosophyQuotes = [
  { text: 'What truly sets him apart is how approachable, patient, and generous he is with that expertise.', name: 'Kevin P. Thompson', role: 'Associate Dean for Advancement, UW' },
  { text: 'In a space often occupied by people unable to explain complexity, Jasvant has always valued being the complete opposite.', name: 'Tiffany Calverley', role: 'Director of Development, Social Sciences, UW' },
];
---
<Base
  title="About — Track Record & Experience"
  description="The track record of Jasvant Singh Dosanjh: a Technical Program Manager who has delivered programs across healthcare, education, gaming, and big tech — roadmaps, budgets, vendors, SDLC, and GRC."
  keywords={["Jasvant Dosanjh about", "Technical Program Manager experience", "technical program management track record", "Technical Project Manager", "IT Program Manager", "problem solver", "program manager résumé"]}
  preloadImage="/images/headshot-spotlight.jpg"
  ogImage="/og/about.png"
>
  <!-- ===================== STORY HERO ===================== -->
  <section class="relative pt-36 sm:pt-48 pb-12 overflow-hidden">
    <div class="absolute left-1/2 -translate-x-1/2 top-20 h-80 w-80 rounded-full bg-kesari-500/12 blur-[100px]"></div>
    <!-- orbit rings -->
    <div class="absolute left-1/2 top-44 -translate-x-1/2 -translate-y-1/2 w-[34rem] h-[34rem] orbit-ring opacity-40 animate-spin-slow hidden sm:block"></div>
    <div class="absolute left-1/2 top-44 -translate-x-1/2 -translate-y-1/2 w-[24rem] h-[24rem] orbit-ring opacity-60 hidden sm:block"></div>

    <div class="container-x relative text-center">
      <p class="reveal is-visible eyebrow eyebrow-center">Background</p>
      <h1 class="mt-5 type-display-1 text-navy-900" data-kinetic>
        <span class="kin-line"><span class="kin-inner">Jasvant Singh Dosanjh</span></span>
      </h1>
      <p class="reveal is-visible mt-5 type-title-3 font-medium text-gradient">
        Problem-solver by instinct. Solutions-driven by choice.
      </p>
      <p class="reveal is-visible mt-4 type-subhead text-ink-600">
        Open to <span class="text-ink-800">Technical Program Manager</span> · <span class="text-ink-800">Technical Project Manager</span> · <span class="text-ink-800">IT Program Manager</span> roles
      </p>
      <p class="reveal is-visible mt-6 max-w-2xl mx-auto text-ink-600 leading-relaxed">
        The settings have changed a lot over ten years — healthcare, higher ed, gaming, big tech — but the job hasn’t. I
        take the program nobody can see the end of, break it into work people can actually schedule, and land it on a date
        I gave them up front.
      </p>
      <div class="reveal is-visible mt-8 flex flex-wrap justify-center gap-2.5">
        {journeyCreed.values.map((v) => (
          <span class="rounded-full bg-kesari-500/12 border border-kesari-500/25 px-4 py-1.5 type-subhead font-medium text-kesari-700">{v}</span>
        ))}
      </div>
      <div class="reveal is-visible mt-8 flex flex-wrap justify-center gap-2.5">
        {site.resumes.map((r) => (
          <a href={r.href} download data-magnetic="0.3" class="btn btn-secondary type-subhead"><Icon name="file" size={16} /> {r.short} Résumé</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== PROBLEM-SOLVER SUMMARY ===================== -->
  <section class="container-x mt-28">
    <div class="reveal card border-glow p-8 sm:p-10">
      <div class="grid lg:grid-cols-[1fr_1.4fr] gap-8 items-center">
        <div class="relative rounded-2xl overflow-hidden border border-navy-800/12 border-glow max-w-xs" data-parallax="0.05">
          <Portrait src={url('/images/headshot-spotlight.jpg')} alt="Jasvant Singh Dosanjh" class="aspect-[4/5]" focus="50% 46%" />
          <span class="pointer-events-none absolute bottom-3 left-3.5 rounded bg-paper-50/90 px-2 py-1 type-mono-sm tracking-[0.2em] text-ink-600">EST. 2016</span>
        </div>
        <div>
          <h2 class="type-title-2 text-navy-900">The pattern behind every chapter</h2>
          <p class="mt-4 text-ink-600 leading-relaxed">
            Most problems aren’t really technical problems. They’re coordination problems, trust problems, or gaps in
            knowledge that eventually surface in the work. What Jasvant does well is spot those gaps and then work with the
            team to close them for good. Over 10+ years across education, healthcare, gaming, and big tech, a lot of the
            frameworks he built outlived his involvement, picked up by other teams, departments, and studios.
          </p>
          <p class="mt-4 text-ink-600 leading-relaxed">
            He builds with one assumption — <span class="text-kesari-700">that what he makes will be used far beyond its original scope</span> —
            and serves with one belief: that something valuable should never stay locked away where only one person can reach it.
          </p>
          <p class="mt-4 type-subhead text-ink-500">
            Fluent in English and Punjabi, conversational in Hindi and Urdu. Plays harmonium, tabla, and dholki.
            Loyal to Manchester United through every challenge.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== THE TRAJECTORY ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Origin story" title="The trajectory" align="center">
      <p class="reveal mt-4 max-w-2xl mx-auto text-ink-600">Same instinct, five very different rooms — from a schoolyard in Michigan to a global stage.</p>
    </SectionHeading>
    <div class="mt-12 max-w-2xl mx-auto">
      <JourneyTrail />
    </div>
  </section>

  <!-- ===================== PHILOSOPHY ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="How I run a program" title="The register I keep" align="center">
      <p class="reveal mt-4 max-w-2xl mx-auto text-ink-600">
        Risks, assumptions, issues, dependencies. Every program I have run came down to how honestly these four were
        tracked — so rather than list values, here is the operating rule for each one and the program that proves it.
      </p>
    </SectionHeading>

    <div class="mt-12 card overflow-hidden divide-y divide-navy-800/[0.08]">
      {raid.map((r) => (
        <div class="reveal grid gap-x-6 gap-y-3 p-6 sm:p-6 md:grid-cols-[3.5rem_1fr_1fr] md:items-start hover:bg-paper-200/40 transition-colors">
          <span
            class="grid place-items-center h-12 w-12 rounded-xl bg-kesari-500/14 border border-kesari-500/35 font-display type-title-4 font-bold text-kesari-700 shrink-0"
            aria-hidden="true"
          >{r.key}</span>
          <div>
            <h3 class="font-display type-body font-semibold text-navy-900">{r.heading}</h3>
            <p class="mt-1 type-subhead font-semibold text-kesari-700">{r.rule}</p>
            <p class="mt-2.5 type-subhead leading-relaxed text-ink-600">{r.text}</p>
          </div>
          <figure class="rounded-xl bg-paper-200/70 border border-navy-800/[0.08] p-4">
            <figcaption class="type-label font-semibold text-ink-400">In practice</figcaption>
            <p class="mt-1.5 type-footnote leading-relaxed text-ink-700">{r.evidence}</p>
          </figure>
        </div>
      ))}
    </div>

    <!-- The senior difference -->
    <div class="turn mt-8 relative card border-glow overflow-hidden p-8 sm:p-10">
      <div class="absolute -right-12 -top-12 h-48 w-48 rounded-full bg-kesari-500/10 blur-3xl"></div>
      <div class="relative grid lg:grid-cols-[1.25fr_1fr] gap-8 items-center">
        <div>
          <h3 class="type-title-3 text-navy-900">Depth you can trust — explained so everyone gets it</h3>
          <p class="mt-4 text-ink-600 leading-relaxed">
            The part I take most seriously is understanding a system well enough to explain it simply. I’m not trying to
            sound like the smartest person in the room. I’m trying to make something complex feel approachable, for engineers
            and executives alike. When people understand the “why,” they trust the plan — and a plan people trust is the
            difference between a program that stalls in status meetings and one that ships.
          </p>
        </div>
        <div class="space-y-4">
          {philosophyQuotes.map((q) => (
            <figure class="rounded-xl bg-paper-200/60 border border-navy-800/[0.10] p-5">
              <blockquote class="type-subhead leading-relaxed text-ink-700">“{q.text}”</blockquote>
              <figcaption class="mt-3 type-caption text-ink-500">— {q.name}, <span class="text-ink-600">{q.role}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PROJECTS I'VE LED ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Selected work" title="Programs & projects I’ve led" align="center">
      <p class="reveal mt-4 max-w-2xl mx-auto text-ink-600">A decade of programs and projects across education, healthcare, gaming, and big tech — each one shipped on a date, and many adopted well beyond their original scope.</p>
    </SectionHeading>

    <!-- Headline projects -->
    <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {headlineProjects.map((p) => (
        <article class="reveal card card-hover flex flex-col overflow-hidden">
          <header class="flex items-center justify-between gap-3 px-5 py-2.5 border-b border-navy-800/[0.08] bg-paper-200/50">
            <span class:list={['chip', statusChip[p.status]]}>{statusLabel[p.status]}</span>
            <span class="type-mono-sm text-ink-500">{p.date}</span>
          </header>
          <div class="p-5 flex flex-col flex-1">
            <h3 class="font-display type-callout font-semibold text-navy-900 leading-snug">{p.title}</h3>
            <p class="text-navy-600 type-caption font-medium mt-1">{p.org}</p>
            <p class="mt-3 type-subhead leading-relaxed text-ink-600 flex-1">{p.text}</p>
            {p.facts && (
              <dl class="mt-5 pt-4 hairline grid grid-cols-2 gap-x-4 gap-y-2.5">
                {p.facts.map((f) => (
                  <div>
                    <dt class="type-label text-ink-400">{f.label}</dt>
                    <dd class="type-footnote font-semibold text-navy-900 mt-0.5">{f.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- More work (compact) -->
    <h3 class="reveal mt-12 eyebrow eyebrow-center">More work</h3>
    <div class="reveal mt-5 max-w-4xl mx-auto grid sm:grid-cols-2 gap-x-8 gap-y-px rounded-2xl overflow-hidden border border-navy-800/[0.10]">
      {moreProjects.map((m) => (
        <div class="bg-paper-200/60 px-5 py-3.5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <span class="type-subhead font-medium text-ink-800">{m.title}</span>
            <span class="type-mono-sm text-ink-500 shrink-0">{m.date}</span>
          </div>
          <p class="type-caption text-navy-600 mt-0.5">{m.org}{m.note && <span class="text-ink-500"> · {m.note}</span>}</p>
        </div>
      ))}
    </div>

    <!-- Personal / open-source — tabbed premium showcase -->
    <h3 class="reveal mt-16 eyebrow eyebrow-center">Things I build</h3>
    <p class="reveal mt-3 text-center type-subhead text-ink-500 max-w-xl mx-auto">Two threads of the same work: preserving Sikh heritage, and open-sourcing tools for IT &amp; security teams. Browse both, or see the <a href={url('/products')} class="link-control text-navy-700 hover:underline underline-offset-4">products page</a>.</p>

    <div class="reveal mt-6 max-w-4xl mx-auto" data-tabs>
      <div role="tablist" aria-label="Project type" class="flex justify-center gap-1.5">
        {showcaseTabs.map((t, i) => (
          <button type="button" role="tab" id={`tab-${t.id}`} class="tab-btn" data-tab={t.id} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'}>
            <span class="text-ink-400">#</span> {t.label}
          </button>
        ))}
      </div>
      {showcaseTabs.map((t, i) => (
        <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} class="tab-panel mt-6 grid gap-5 md:grid-cols-2" data-panel={t.id} hidden={i !== 0}>
          {t.items.map((p) => (
            <a
              href={p.links[0]?.href ?? url('/products')}
              target={p.links[0]?.href?.startsWith('http') ? '_blank' : undefined}
              rel="noopener noreferrer"
              class="group card card-hover border-glow p-6 flex flex-col"
            >
              <div class="flex items-center gap-3 min-w-0">
                <span class:list={['grid place-items-center h-11 w-11 rounded-xl bg-paper-200 border border-navy-800/12 shrink-0', p.accent === 'kesari' ? 'text-kesari-700' : 'text-navy-600']}>
                  {p.gurmukhi ? <span class="gurmukhi type-title-4 leading-none" lang="pa">{p.gurmukhi}</span> : <span class="font-display font-bold type-body">{p.name.charAt(0)}</span>}
                </span>
                <div class="min-w-0">
                  <h4 class="font-display type-callout font-semibold text-navy-900 leading-tight">{p.name}</h4>
                  <p class="type-label text-ink-500 mt-0.5">{p.category}</p>
                </div>
                {p.openSource && <span class="ml-auto shrink-0 type-mono-sm text-status-green border border-status-green/25 rounded-md px-2 py-0.5">OSS</span>}
              </div>
              <p class:list={['mt-4 type-subhead font-medium', p.accent === 'kesari' ? 'text-kesari-700' : 'text-navy-600']}>{p.tagline}</p>
              <p class="mt-4 link-control type-subhead font-medium text-ink-600 group-hover:text-navy-900"><Icon name="arrow" size={15} class="group-hover:translate-x-0.5 transition-transform" /> {p.links[0]?.label ?? 'Learn more'}</p>
            </a>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== CAREER TIMELINE ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Experience" title="Career roadmap">
      <p class="reveal mt-4 max-w-2xl text-ink-600">Ten years of roles, to scale — including the stretches where a contract engagement ran alongside a full-time one.</p>
    </SectionHeading>
    <div class="mt-10">
      <ProgramRoadmap />
    </div>
  </section>

  <!-- ===================== LEADERSHIP ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Beyond the title" title="Leadership & activities" />
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {leadership.map((item) => (
        <div class="reveal card card-hover p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <h3 class="font-display type-callout font-semibold text-navy-900">{item.title}</h3>
            <span class="type-mono-sm text-ink-500 shrink-0">{item.date}</span>
          </div>
          <p class="text-navy-600 type-subhead font-medium mt-0.5">{item.org}</p>
          <ul class="mt-4 space-y-2">
            {item.bullets.map((b) => (
              <li class="flex gap-2.5 type-subhead text-ink-600 leading-relaxed"><span class="mt-1.5 h-1 w-1 rounded-full bg-navy-600 shrink-0"></span><span>{b}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== EDUCATION ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Foundations" title="Education & certifications" />
    <div class="mt-10 grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="space-y-4">
        {education.map((e) => (
          <div class="reveal card p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <h3 class="font-display type-callout font-semibold text-navy-900">{e.credential}</h3>
              {e.date && <span class="type-mono-sm text-ink-500 shrink-0">{e.date}</span>}
            </div>
            <p class="text-kesari-700 type-subhead font-medium mt-0.5">{e.school}</p>
            {e.detail && <p class="mt-2 type-subhead text-ink-600">{e.detail}</p>}
          </div>
        ))}
      </div>
      <div class="reveal card p-6 h-max">
        <h3 class="eyebrow">Key certifications · 2023–2026</h3>
        <ul class="mt-5 space-y-3">
          {certifications.map((c) => (
            <li class="flex gap-3 type-subhead text-ink-700"><Icon name="shield" size={16} class="text-kesari-600/90 shrink-0 mt-0.5" /><span>{c}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ===================== RECOMMENDATIONS ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="In their words" title="Recommendations" />
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {recommendations.map((r) => (
        <figure class="reveal card p-6 flex flex-col">
          <div class="text-kesari-500/55 font-display type-display-2 leading-none">“</div>
          <blockquote class="-mt-3 type-subhead leading-relaxed text-ink-700 flex-1">{r.text}</blockquote>
          <figcaption class="mt-5 pt-5 hairline">
            <p class="font-display type-subhead font-semibold text-navy-900">{r.name}</p>
            <p class="type-caption text-ink-500 mt-0.5">{r.title}</p>
            <a href={r.link} target="_blank" rel="noopener noreferrer" class="link-control type-caption text-navy-600 hover:underline underline-offset-4"><Icon name="linkedin" size={13} /> LinkedIn</a>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="container-x mt-28">
    <div class="reveal text-center">
      <h2 class="type-title-1 text-navy-900">The next program could be yours.</h2>
      <a href={url('/contact')} data-magnetic="0.35" class="mt-6 btn btn-primary">Let’s talk <Icon name="arrow" size={18} /></a>
    </div>
  </section>
</Base>

<script>
  function wireTabs() {
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
      if ((root as any)._tabs) return;
      (root as any)._tabs = true;
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
      const select = (id: string, focus = false) => {
        tabs.forEach((t) => {
          const on = t.dataset.tab === id;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          if (on && focus) t.focus();
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.panel !== id;
          // Cards in a tab hidden at load time get measured by GSAP's
          // ScrollTrigger while display:none (zero-size), so they can be
          // stuck at opacity 0 the first time their panel is shown. Force
          // them visible on switch rather than relying on GSAP's own state.
          if (!p.hidden) {
            p.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
              el.classList.add('is-visible');
              el.style.opacity = '1';
              el.style.transform = 'none';
            });
          }
        });
      };
      tabs.forEach((t) => {
        t.tabIndex = t.getAttribute('aria-selected') === 'true' ? 0 : -1;
        t.addEventListener('click', () => select(t.dataset.tab || ''));
        t.addEventListener('keydown', (e) => {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) return;
          e.preventDefault();
          let idx = tabs.indexOf(t);
          if (e.key === 'ArrowLeft') idx = (idx - 1 + tabs.length) % tabs.length;
          else if (e.key === 'ArrowRight') idx = (idx + 1) % tabs.length;
          else if (e.key === 'Home') idx = 0;
          else if (e.key === 'End') idx = tabs.length - 1;
          select(tabs[idx].dataset.tab || '', true);
        });
      });
    });
  }
  wireTabs();
  document.addEventListener('astro:page-load', wireTabs);
</script>
