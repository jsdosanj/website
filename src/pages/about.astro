---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import Spotlight from '../components/Spotlight.astro';
import JourneyTrail from '../components/JourneyTrail.astro';
import { experience } from '../data/experience';
import { leadership } from '../data/leadership';
import { education, certifications } from '../data/education';
import { recommendations } from '../data/recommendations';
import { journeyCreed } from '../data/journey';
import { headlineProjects, moreProjects } from '../data/projectsLed';
import { products } from '../data/products';
import { site } from '../data/site';
import { url } from '../utils';

const sikhiProjects = products.filter((p) => p.accent === 'kesari');
const ossProjects = products.filter((p) => p.openSource);
const showcaseTabs = [
  { id: 'sikhi', label: 'sikhi & heritage', items: sikhiProjects },
  { id: 'oss', label: 'open-source', items: ossProjects },
];

const philosophy = [
  { icon: 'workflow', title: 'Build with intent', text: 'I’d rather build something once, thoughtfully, than patch it forever. I assume whatever I make will be used beyond its original scope — so I document it and make it easy for the next person to pick up.' },
  { icon: 'shield', title: 'Proactive, not reactive', text: 'Waiting for a breach to reveal the gap is a plan that has already failed. I prefer to bake protection in early and quietly, so security is a habit rather than a fire drill.' },
  { icon: 'sparkles', title: 'Technology should amplify', text: 'The win is never “more tools.” It’s removing the friction between people and their best work, so the technology fades into the background and the team moves faster.' },
  { icon: 'target', title: 'IT as a success model', text: 'Done well, IT helps an organization move faster, spend smarter, and actually trust its technology. Getting it to that point, an advantage instead of a drag, is the bar I hold myself to.' },
  { icon: 'spark', title: 'Lead with compassion', text: 'Kindness, patience, and forgiveness aren’t extras — they’re how trust gets built. I want people to walk away from working with me feeling supported rather than judged, ideally with a smile.' },
  { icon: 'globe', title: 'Technology works for people', text: 'Not the other way around. Every decision I make starts and ends with the person on the other side of the screen.' },
];

const philosophyQuotes = [
  { text: 'What truly sets him apart is how approachable, patient, and generous he is with that expertise.', name: 'Kevin P. Thompson', role: 'Associate Dean for Advancement, UW' },
  { text: 'In a space often occupied by people unable to explain complexity, Jasvant has always valued being the complete opposite.', name: 'Tiffany Calverley', role: 'Director of Development, Social Sciences, UW' },
];
---
<Base
  title="About — Track Record & Experience"
  description="The track record of Jasvant Singh Dosanjh: an IT Manager who has led matrixed teams across healthcare, education, gaming, and big tech — SDLC, Agile delivery, GRC."
  keywords={["Jasvant Dosanjh about", "IT Manager story", "IT Manager experience", "problem solver", "interim helpdesk manager", "IT leadership résumé"]}
  preloadImage="/images/headshot-spotlight.jpg"
  ogImage="/og/about.png"
>
  <!-- ===================== STORY HERO ===================== -->
  <section class="relative pt-36 sm:pt-48 pb-12 overflow-hidden">
    <div class="starfield"></div>
    <div class="absolute left-1/2 -translate-x-1/2 top-20 h-80 w-80 rounded-full bg-kesari-500/10 blur-[100px]"></div>
    <!-- orbit rings -->
    <div class="absolute left-1/2 top-44 -translate-x-1/2 -translate-y-1/2 w-[34rem] h-[34rem] orbit-ring opacity-40 animate-spin-slow hidden sm:block"></div>
    <div class="absolute left-1/2 top-44 -translate-x-1/2 -translate-y-1/2 w-[24rem] h-[24rem] orbit-ring opacity-60 hidden sm:block"></div>

    <div class="container-x relative text-center">
      <p class="reveal is-visible mono text-xs uppercase tracking-[0.28em] text-kesari-400">$ whoami</p>
      <h1 class="mt-5 font-display text-4xl sm:text-6xl font-bold tracking-tight text-mist-100 leading-[1.05]" data-kinetic>
        <span class="kin-line"><span class="kin-inner">Jasvant Singh Dosanjh</span></span>
      </h1>
      <p class="reveal is-visible mt-5 text-lg sm:text-xl text-gradient font-display font-medium">
        Problem-solver by instinct. Solutions-driven by choice.
      </p>
      <p class="reveal is-visible mt-4 mono text-sm text-mist-400">
        Open to <span class="text-mist-200">IT Manager</span> · <span class="text-mist-200">IT Program / Project Manager</span> · <span class="text-mist-200">Senior Systems Engineer</span> roles
      </p>
      <p class="reveal is-visible mt-6 max-w-2xl mx-auto text-mist-400 leading-relaxed">
        The settings have changed a lot over ten years — healthcare, higher ed, gaming, big tech — but the job hasn’t. I
        find what’s broken, fix it, and build something the team can keep relying on long after I’ve moved on.
      </p>
      <div class="reveal is-visible mt-8 flex flex-wrap justify-center gap-2.5">
        {journeyCreed.values.map((v) => (
          <span class="rounded-full glass px-4 py-1.5 text-sm text-kesari-200">{v}</span>
        ))}
      </div>
      <div class="reveal is-visible mt-9 flex flex-wrap justify-center gap-2.5">
        {site.resumes.map((r) => (
          <a href={r.href} download data-magnetic="0.3" class="inline-flex items-center gap-2 rounded-xl glass px-4 py-2.5 text-sm font-medium text-mist-200 hover:border-white/20 transition-colors"><Icon name="file" size={16} /> {r.short} Résumé</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== PROBLEM-SOLVER SUMMARY ===================== -->
  <section class="container-x mt-28">
    <div class="reveal card border-glow p-8 sm:p-10">
      <div class="grid lg:grid-cols-[1fr_1.4fr] gap-8 items-center">
        <div class="relative rounded-2xl overflow-hidden border border-white/10 border-glow max-w-xs" data-parallax="0.05">
          <Spotlight src={url('/images/headshot-spotlight.jpg')} alt="Jasvant Singh Dosanjh" class="aspect-[4/5]" focus="50% 46%" />
          <span class="pointer-events-none absolute bottom-3 left-3.5 mono text-[10px] tracking-[0.25em] text-mist-300/70">EST. 2016</span>
        </div>
        <div>
          <h2 class="font-display text-2xl sm:text-3xl font-semibold text-mist-100">The pattern behind every chapter</h2>
          <p class="mt-4 text-mist-400 leading-relaxed">
            Most problems aren’t really technical problems. They’re coordination problems, trust problems, or gaps in
            knowledge that eventually surface in the work. What Jasvant does well is spot those gaps and then work with the
            team to close them for good. Over 10+ years across education, healthcare, gaming, and big tech, a lot of the
            frameworks he built outlived his involvement, picked up by other teams, departments, and studios.
          </p>
          <p class="mt-4 text-mist-400 leading-relaxed">
            He builds with one assumption — <span class="text-kesari-300">that what he makes will be used far beyond its original scope</span> —
            and serves with one belief: that something valuable should never stay locked away where only one person can reach it.
          </p>
          <p class="mt-4 text-sm text-mist-500">
            Fluent in English and Punjabi, conversational in Hindi and Urdu. Plays harmonium, tabla, and dholki.
            Loyal to Manchester United through every challenge.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== THE TRAJECTORY ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Origin story" title="The trajectory" align="center">
      <p class="reveal mt-4 max-w-2xl mx-auto text-mist-400">Same instinct, five very different rooms — from a schoolyard in Michigan to a global stage.</p>
    </SectionHeading>
    <div class="mt-12 max-w-2xl mx-auto">
      <JourneyTrail />
    </div>
  </section>

  <!-- ===================== PHILOSOPHY ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Philosophy" title="How I work" align="center">
      <p class="reveal mt-4 max-w-2xl mx-auto text-mist-400">
        A senior hire knows the technology deeply, but the real test is holding that depth and still making it
        approachable for everyone in the room. Here’s what I try to bring to a team.
      </p>
    </SectionHeading>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {philosophy.map((p) => (
        <div class="reveal card card-hover p-6">
          <span class="grid place-items-center h-11 w-11 rounded-xl bg-ink-800 border border-white/10 text-kesari-400"><Icon name={p.icon} size={20} /></span>
          <h3 class="mt-4 font-display text-base font-semibold text-mist-100">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-mist-400">{p.text}</p>
        </div>
      ))}
    </div>

    <!-- The senior difference -->
    <div class="turn mt-8 relative card border-glow overflow-hidden p-8 sm:p-10">
      <div class="absolute -right-12 -top-12 h-48 w-48 rounded-full bg-kesari-500/10 blur-3xl"></div>
      <div class="relative grid lg:grid-cols-[1.25fr_1fr] gap-8 items-center">
        <div>
          <h3 class="font-display text-xl sm:text-2xl font-semibold text-mist-100">Depth you can trust — explained so everyone gets it</h3>
          <p class="mt-4 text-mist-400 leading-relaxed">
            The part I take most seriously is understanding a system well enough to explain it simply. I’m not trying to
            sound like the smartest person in the room. I’m trying to make something complex feel approachable, for engineers
            and non-technical teammates alike. When people understand the “why,” they trust the work, and that’s the difference
            between a team that tolerates IT and one that genuinely leans on it.
          </p>
        </div>
        <div class="space-y-4">
          {philosophyQuotes.map((q) => (
            <figure class="rounded-xl bg-ink-800/60 border border-white/[0.06] p-5">
              <blockquote class="text-sm leading-relaxed text-mist-300">“{q.text}”</blockquote>
              <figcaption class="mt-3 text-xs text-mist-500">— {q.name}, <span class="text-mist-400">{q.role}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PROJECTS I'VE LED ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Selected work" title="Projects I’ve led" align="center">
      <p class="reveal mt-4 max-w-2xl mx-auto text-mist-400">A decade of hands-on projects across education, healthcare, gaming, and big tech — each one shipped, and many adopted well beyond their original scope.</p>
    </SectionHeading>

    <!-- Headline projects -->
    <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {headlineProjects.map((p) => (
        <div class="reveal card card-hover border-glow p-6 flex flex-col">
          <span class="mono text-[11px] uppercase tracking-wider text-kesari-400">{p.date}</span>
          <h3 class="mt-2 font-display text-base font-semibold text-mist-100 leading-snug">{p.title}</h3>
          <p class="text-azure-300 text-xs font-medium mt-1.5">{p.org}</p>
          <p class="mt-3 text-sm leading-relaxed text-mist-400 flex-1">{p.text}</p>
        </div>
      ))}
    </div>

    <!-- More work (compact) -->
    <h3 class="reveal mt-12 mono text-xs uppercase tracking-[0.22em] text-mist-500 text-center">More work</h3>
    <div class="reveal mt-5 max-w-4xl mx-auto grid sm:grid-cols-2 gap-x-8 gap-y-px rounded-2xl overflow-hidden border border-white/[0.06]">
      {moreProjects.map((m) => (
        <div class="bg-ink-850/60 px-5 py-3.5">
          <div class="flex items-baseline justify-between gap-3">
            <span class="text-sm font-medium text-mist-200">{m.title}</span>
            <span class="mono text-[11px] text-mist-500 shrink-0">{m.date}</span>
          </div>
          <p class="text-xs text-azure-300/90 mt-0.5">{m.org}{m.note && <span class="text-mist-500"> · {m.note}</span>}</p>
        </div>
      ))}
    </div>

    <!-- Personal / open-source — tabbed premium showcase -->
    <h3 class="reveal mt-14 mono text-xs uppercase tracking-[0.22em] text-kesari-400 text-center">Things I build</h3>
    <p class="reveal mt-3 text-center text-sm text-mist-500 max-w-xl mx-auto">Two threads of the same work: preserving Sikh heritage, and open-sourcing tools for IT &amp; security teams. Browse both, or see the <a href={url('/products')} class="text-kesari-300 hover:underline underline-offset-4">products page</a>.</p>

    <div class="reveal mt-7 max-w-4xl mx-auto" data-tabs>
      <div role="tablist" aria-label="Project type" class="flex justify-center gap-1.5">
        {showcaseTabs.map((t, i) => (
          <button type="button" role="tab" id={`tab-${t.id}`} class="tab-btn" data-tab={t.id} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'}>
            <span class="text-mist-600">#</span> {t.label}
          </button>
        ))}
      </div>
      {showcaseTabs.map((t, i) => (
        <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} class="tab-panel mt-7 grid gap-5 md:grid-cols-2" data-panel={t.id} hidden={i !== 0}>
          {t.items.map((p) => (
            <a
              href={p.links[0]?.href ?? url('/products')}
              target={p.links[0]?.href?.startsWith('http') ? '_blank' : undefined}
              rel="noopener noreferrer"
              class="group card card-hover border-glow p-6 flex flex-col"
            >
              <div class="flex items-center gap-3">
                <span class:list={['grid place-items-center h-11 w-11 rounded-xl bg-ink-800 border border-white/10 shrink-0', p.accent === 'kesari' ? 'text-kesari-400' : 'text-azure-400']}>
                  {p.gurmukhi ? <span class="gurmukhi text-xl leading-none" lang="pa">{p.gurmukhi}</span> : <span class="font-display font-bold text-lg">{p.name.charAt(0)}</span>}
                </span>
                <div class="min-w-0">
                  <h4 class="font-display text-base font-semibold text-mist-100 leading-tight">{p.name}</h4>
                  <p class="mono text-[10px] uppercase tracking-wider text-mist-500 mt-0.5">{p.category}</p>
                </div>
                {p.openSource && <span class="ml-auto shrink-0 mono text-[10px] text-phos-300 border border-phos-400/25 rounded-md px-2 py-0.5">OSS</span>}
              </div>
              <p class:list={['mt-4 text-sm font-medium', p.accent === 'kesari' ? 'text-kesari-300' : 'text-azure-300']}>{p.tagline}</p>
              <p class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-mist-400 group-hover:text-kesari-300 transition-colors"><Icon name="arrow" size={15} class="group-hover:translate-x-0.5 transition-transform" /> {p.links[0]?.label ?? 'Learn more'}</p>
            </a>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== CAREER TIMELINE ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Experience" title="Career at a glance" />
    <div class="mt-10 relative">
      <div class="absolute left-[6px] top-2 bottom-2 w-px bg-gradient-to-b from-kesari-500/50 via-white/10 to-transparent"></div>
      <div class="space-y-2.5">
        {experience.map((role) => (
          <div class="reveal relative pl-8">
            <span class="absolute left-0 top-[15px] h-[13px] w-[13px] rounded-full border-2 border-kesari-500 bg-ink-900"></span>
            <div class="card px-5 py-3.5 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-0.5">
              <p class="text-mist-100">
                <span class="font-display font-semibold">{role.title}</span>
                <span class="text-kesari-300"> · {role.company}</span>
              </p>
              <span class="mono text-xs text-mist-500 shrink-0">{role.date}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== LEADERSHIP ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Beyond the title" title="Leadership & activities" />
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {leadership.map((item) => (
        <div class="reveal card card-hover p-6">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="font-display text-base font-semibold text-mist-100">{item.title}</h3>
            <span class="mono text-[11px] text-mist-500 shrink-0">{item.date}</span>
          </div>
          <p class="text-azure-300 text-sm font-medium mt-0.5">{item.org}</p>
          <ul class="mt-4 space-y-2">
            {item.bullets.map((b) => (
              <li class="flex gap-2.5 text-sm text-mist-400 leading-relaxed"><span class="mt-1.5 h-1 w-1 rounded-full bg-azure-500 shrink-0"></span><span>{b}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== EDUCATION ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Foundations" title="Education & certifications" />
    <div class="mt-10 grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="space-y-4">
        {education.map((e) => (
          <div class="reveal card p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-base font-semibold text-mist-100">{e.credential}</h3>
              {e.date && <span class="mono text-[11px] text-mist-500 shrink-0">{e.date}</span>}
            </div>
            <p class="text-kesari-300 text-sm font-medium mt-0.5">{e.school}</p>
            {e.detail && <p class="mt-2 text-sm text-mist-400">{e.detail}</p>}
          </div>
        ))}
      </div>
      <div class="reveal card p-6 h-max">
        <h3 class="mono text-xs uppercase tracking-widest text-kesari-400">Key Certifications · 2023–2026</h3>
        <ul class="mt-5 space-y-3">
          {certifications.map((c) => (
            <li class="flex gap-3 text-sm text-mist-300"><Icon name="shield" size={16} class="text-kesari-500/80 shrink-0 mt-0.5" /><span>{c}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ===================== RECOMMENDATIONS ===================== -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="In their words" title="Recommendations" />
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {recommendations.map((r) => (
        <figure class="reveal card p-6 flex flex-col">
          <div class="text-kesari-500/40 font-display text-5xl leading-none">“</div>
          <blockquote class="-mt-3 text-sm leading-relaxed text-mist-300 flex-1">{r.text}</blockquote>
          <figcaption class="mt-5 pt-5 hairline">
            <p class="font-display text-sm font-semibold text-mist-100">{r.name}</p>
            <p class="text-xs text-mist-500 mt-0.5">{r.title}</p>
            <a href={r.link} target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1.5 text-xs text-azure-300 hover:underline underline-offset-4"><Icon name="linkedin" size={13} /> LinkedIn</a>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="container-x mt-28">
    <div class="reveal text-center">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold text-mist-100">The next chapter could be with your team.</h2>
      <a href={url('/contact')} data-magnetic="0.35" class="mt-7 inline-flex items-center gap-2 rounded-xl bg-kesari-500 text-ink-950 px-6 py-3.5 font-semibold hover:bg-kesari-400 transition-colors">Let’s talk <Icon name="arrow" size={18} /></a>
    </div>
  </section>
</Base>

<script>
  function wireTabs() {
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
      if ((root as any)._tabs) return;
      (root as any)._tabs = true;
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
      const select = (id: string, focus = false) => {
        tabs.forEach((t) => {
          const on = t.dataset.tab === id;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          if (on && focus) t.focus();
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.panel !== id;
          // Cards in a tab hidden at load time get measured by GSAP's
          // ScrollTrigger while display:none (zero-size), so they can be
          // stuck at opacity 0 the first time their panel is shown. Force
          // them visible on switch rather than relying on GSAP's own state.
          if (!p.hidden) {
            p.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
              el.classList.add('is-visible');
              el.style.opacity = '1';
              el.style.transform = 'none';
            });
          }
        });
      };
      tabs.forEach((t) => {
        t.tabIndex = t.getAttribute('aria-selected') === 'true' ? 0 : -1;
        t.addEventListener('click', () => select(t.dataset.tab || ''));
        t.addEventListener('keydown', (e) => {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) return;
          e.preventDefault();
          let idx = tabs.indexOf(t);
          if (e.key === 'ArrowLeft') idx = (idx - 1 + tabs.length) % tabs.length;
          else if (e.key === 'ArrowRight') idx = (idx + 1) % tabs.length;
          else if (e.key === 'Home') idx = 0;
          else if (e.key === 'End') idx = tabs.length - 1;
          select(tabs[idx].dataset.tab || '', true);
        });
      });
    });
  }
  wireTabs();
  document.addEventListener('astro:page-load', wireTabs);
</script>
