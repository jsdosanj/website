---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { experience } from '../data/experience';
import { leadership } from '../data/leadership';
import { education, certifications } from '../data/education';
import { recommendations } from '../data/recommendations';
import { site } from '../data/site';
import { url } from '../utils';
---
<Base title="About" description="Jasvant Singh Dosanjh — Technical Project Manager in Seattle with 10+ years across education, healthcare, gaming, and big tech.">
  <!-- Intro -->
  <section class="container-x pt-36 sm:pt-44">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-12 items-start">
      <div class="reveal is-visible lg:sticky lg:top-28">
        <div class="rounded-[1.5rem] overflow-hidden border border-white/10 glow-ring max-w-xs">
          <img src={url('/images/headshot.jpg')} alt="Jasvant Singh Dosanjh" class="w-full aspect-[4/5] object-cover" width="480" height="600" />
        </div>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={site.resumes.tpm} download class="inline-flex items-center gap-2 rounded-lg glass px-4 py-2.5 text-sm font-medium text-mist-200 hover:border-white/20 transition-colors"><Icon name="file" size={16} /> TPM Résumé</a>
          <a href={site.resumes.csm} download class="inline-flex items-center gap-2 rounded-lg glass px-4 py-2.5 text-sm font-medium text-mist-200 hover:border-white/20 transition-colors"><Icon name="file" size={16} /> CSM Résumé</a>
        </div>
      </div>

      <div class="reveal is-visible">
        <p class="mono text-xs uppercase tracking-[0.22em] text-kesari-400 flex items-center gap-2">
          <span class="inline-block h-px w-6 bg-kesari-500/60"></span>Who I am
        </p>
        <h1 class="mt-4 font-display text-4xl sm:text-5xl font-bold tracking-tight text-mist-100">Jasvant Singh Dosanjh</h1>
        <p class="mt-3 text-lg text-kesari-300 font-medium">Technical Project Manager · Customer Success · IT Leader</p>
        <div class="mt-6 space-y-4 text-mist-400 leading-relaxed">
          <p>Most IT problems aren’t technical problems. They’re coordination problems, trust problems, or documentation gaps that eventually show up in the infrastructure. My job is to find those gaps, fix them, and build something replicable so the next team doesn’t face the same situation.</p>
          <p>Over 10 years across K–12 education, higher ed, healthcare, gaming, and big tech, that approach has produced results that scale past my direct involvement. At the <span class="text-mist-200">University of Washington</span> I rebuilt a clinical department’s broken relationship with IT, cut $30,000/year in redundant spend, and built an onboarding framework later used to centralize four more departments. At <span class="text-mist-200">Meta</span> I found that 5,000 engineers had been locked out of IT support by a Linux gap nobody had addressed, ported the fix myself, and watched it become a first-party vendor product within two weeks. At <span class="text-mist-200">Tencent</span> I built a gaming studio’s entire IT stack from zero in five months — and the identity stack I designed was adopted by two more studios.</p>
          <p>I build with the assumption that what I make will eventually be used beyond its original scope. That’s as true for the AI Sikh library I’m building on 758 million words of multilingual manuscripts as it is for any infrastructure project: <span class="text-kesari-300">something valuable should not stay locked away where only one person can access it.</span></p>
          <p>I’m grounded in Sikh philosophy and active in community and interfaith leadership. I speak English and Punjabi fluently, with conversational Hindi and Urdu — and I play harmonium, tabla, and dholki. I bring the same loyalty and resilience to my work as I do to supporting Manchester United: committed through every challenge.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience timeline -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Career" title="Work experience" />
    <div class="mt-12 relative">
      <div class="absolute left-[7px] sm:left-[9px] top-2 bottom-2 w-px bg-gradient-to-b from-kesari-500/50 via-white/10 to-transparent"></div>
      <div class="space-y-8">
        {experience.map((role) => (
          <div class="reveal relative pl-8 sm:pl-10">
            <span class="absolute left-0 top-1.5 h-[15px] w-[15px] rounded-full border-2 border-kesari-500 bg-ink-900 sm:h-[19px] sm:w-[19px]"></span>
            <div class="card p-5 sm:p-6">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <h3 class="font-display text-lg font-semibold text-mist-100">{role.title}</h3>
                <span class="mono text-xs text-mist-500 shrink-0">{role.date}</span>
              </div>
              <p class="text-kesari-300 text-sm font-medium mt-0.5">{role.company}</p>
              <ul class="mt-4 space-y-2.5">
                {role.bullets.map((b) => (
                  <li class="flex gap-3 text-sm text-mist-400 leading-relaxed">
                    <span class="mono text-kesari-500/70 select-none">›</span><span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Leadership -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Beyond the title" title="Leadership & activities" />
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {leadership.map((item) => (
        <div class="reveal card card-hover p-6">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="font-display text-base font-semibold text-mist-100">{item.title}</h3>
            <span class="mono text-[11px] text-mist-500 shrink-0">{item.date}</span>
          </div>
          <p class="text-azure-300 text-sm font-medium mt-0.5">{item.org}</p>
          <ul class="mt-4 space-y-2">
            {item.bullets.map((b) => (
              <li class="flex gap-2.5 text-sm text-mist-400 leading-relaxed"><span class="mt-1.5 h-1 w-1 rounded-full bg-azure-500 shrink-0"></span><span>{b}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Education + certs -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="Foundations" title="Education & certifications" />
    <div class="mt-10 grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="space-y-4">
        {education.map((e) => (
          <div class="reveal card p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-base font-semibold text-mist-100">{e.credential}</h3>
              <span class="mono text-[11px] text-mist-500 shrink-0">{e.date}</span>
            </div>
            <p class="text-kesari-300 text-sm font-medium mt-0.5">{e.school}</p>
            <p class="mt-2 text-sm text-mist-400">{e.detail}</p>
          </div>
        ))}
      </div>
      <div class="reveal card p-6 h-max">
        <h3 class="mono text-xs uppercase tracking-widest text-kesari-400">Key Certifications · 2023–2026</h3>
        <ul class="mt-5 space-y-3">
          {certifications.map((c) => (
            <li class="flex gap-3 text-sm text-mist-300"><Icon name="shield" size={16} class="text-kesari-500/80 shrink-0 mt-0.5" /><span>{c}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Recommendations -->
  <section class="container-x mt-28">
    <SectionHeading eyebrow="In their words" title="Recommendations" />
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {recommendations.map((r) => (
        <figure class="reveal card p-6 flex flex-col">
          <div class="text-kesari-500/40 font-display text-5xl leading-none">“</div>
          <blockquote class="-mt-3 text-sm leading-relaxed text-mist-300 flex-1">{r.text}</blockquote>
          <figcaption class="mt-5 pt-5 hairline">
            <p class="font-display text-sm font-semibold text-mist-100">{r.name}</p>
            <p class="text-xs text-mist-500 mt-0.5">{r.title}</p>
            <a href={r.link} target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1.5 text-xs text-azure-300 hover:underline underline-offset-4"><Icon name="linkedin" size={13} /> LinkedIn</a>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>
