---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ConstellationBg from '../components/ConstellationBg.astro';
import Cursor from '../components/Cursor.astro';
import BootLoader from '../components/BootLoader.astro';
import Motion from '../components/Motion.astro';
import { site } from '../data/site';
import { url } from '../utils';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  keywords?: string[];
  ogType?: string;
  noindex?: boolean;
  preloadImage?: string;
  jsonld?: object | object[];
}
const {
  title,
  description = site.description,
  ogImage = '/images/og.png',
  keywords = [],
  ogType = 'website',
  noindex = false,
  preloadImage,
  jsonld,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.brand}` : `${site.founder} — ${site.shortTagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

// Breadcrumb trail from the path (helps Google show breadcrumb rich results)
const segments = Astro.url.pathname.replace(import.meta.env.BASE_URL, '').split('/').filter(Boolean);
const crumbItems = [{ name: 'Home', href: site.url }];
let acc = '';
for (const s of segments) {
  acc += '/' + s;
  crumbItems.push({ name: s.charAt(0).toUpperCase() + s.slice(1), href: `${site.url}${acc}` });
}
const extraJsonld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];

const baseKeywords = [
  'Jasvant Dosanjh', 'Jasvant Singh Dosanjh', 'IT Manager', 'IT Manager Seattle',
  'IT Program Manager', 'IT Project Manager', 'Technical Program Manager', 'IT leadership',
  'problem solver', 'AI practitioner', 'Sightline', 'Bastion', 'Cairn',
  'Jamf Pro', 'Intune', 'JumpCloud', 'NIST', 'HIPAA', 'FERPA', 'GRC', 'vendor management',
  'Agile', 'SDLC', 'Seattle technologist', 'Systems Engineering', 'open to work',
];
const allKeywords = [...new Set([...baseKeywords, ...keywords])].join(', ');

// Structured data graph: Person (primary) + ProfilePage + WebSite (helps rich results).
// The whole site is branded to Jasvant Dosanjh (a person), not a company.
const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.founder,
      alternateName: 'Jasvant Dosanjh',
      url: site.url,
      image: new URL('/images/headshot-v2.jpg', site.url).href,
      jobTitle: 'IT Manager',
      address: { '@type': 'PostalAddress', addressLocality: 'Seattle', addressRegion: 'WA', addressCountry: 'US' },
      knowsLanguage: ['English', 'Punjabi', 'Hindi', 'Urdu'],
      knowsAbout: ['AI', 'NLP', 'OCR', 'Cloud Infrastructure', 'Jamf Pro', 'Microsoft Intune', 'JumpCloud', 'NIST CSF', 'HIPAA', 'IT Security', 'GRC', 'Technical Program Management', 'Systems Engineering', 'Endpoint Management'],
      hasOccupation: site.roles.map((r) => ({ '@type': 'Occupation', name: r })),
      seeks: site.roles.map((r) => ({ '@type': 'Demand', name: `${r} role` })),
      sameAs: [site.socials.linkedin, site.socials.github, site.socials.huggingface],
      email: `mailto:${site.email}`,
    },
    {
      '@type': 'ProfilePage',
      '@id': `${site.url}/#profilepage`,
      url: site.url,
      name: site.founder,
      mainEntity: { '@id': `${site.url}/#person` },
      isPartOf: { '@id': `${site.url}/#website` },
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.brand,
      description: site.description,
      publisher: { '@id': `${site.url}/#person` },
      inLanguage: 'en',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: fullTitle,
      description,
      isPartOf: { '@id': `${site.url}/#website` },
      about: { '@id': `${site.url}/#person` },
      inLanguage: 'en',
      primaryImageOfPage: ogImageUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: crumbItems.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: c.href,
      })),
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={allKeywords} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.founder} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#0a0d13" />
    {preloadImage && <link rel="preload" as="image" href={url(preloadImage)} fetchpriority="high" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.brand} — ${site.tagline}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${site.brand} — ${site.tagline}`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+Gurmukhi:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- No-JS fallback: never hide content if scripts don't run -->
    <noscript><style>.reveal{opacity:1 !important;transform:none !important;}</style></noscript>

    <!-- Favicon: personal Khanda emblem -->
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/favicon.svg')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />
    {extraJsonld.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}

    <!-- Cinematic page transitions -->
    <ClientRouter />
  </head>
  <body>
    <div class="bg-aurora"></div>
    <ConstellationBg />
    <div class="bg-scan"></div>
    <div class="bg-grain"></div>

    <!-- Terminal boot sequence (first visit of a session) -->
    <BootLoader />

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-kesari-500 focus:text-ink-950 focus:px-4 focus:py-2 focus:rounded-lg">Skip to content</a>

    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Custom cursor + smooth-scroll / reveal motion layer (desktop, motion-safe) -->
    <Cursor />
    <Motion />

    <!-- Belt-and-braces: if scripts never run, reveal everything -->
    <noscript><style>.reveal{opacity:1 !important;transform:none !important;}#boot{display:none !important;}</style></noscript>
  </body>
</html>
