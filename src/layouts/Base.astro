---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ConstellationBg from '../components/ConstellationBg.astro';
import { site } from '../data/site';
import { url } from '../utils';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  keywords?: string[];
  ogType?: string;
}
const {
  title,
  description = site.description,
  ogImage = '/website/images/og.png',
  keywords = [],
  ogType = 'website',
} = Astro.props;

const fullTitle = title ? `${title} · ${site.brand}` : `${site.brand} — ${site.shortTagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

const baseKeywords = [
  'Dosanjh Labs', 'Jasvant Dosanjh', 'Jasvant Singh Dosanjh', 'Technical Project Manager',
  'problem solver', 'AI developer', 'Sikh technology', 'Sightline', 'GurmukhiFix', 'Cairn',
  'Sikh Library dataset', 'OCR Gurmukhi', 'Seattle technologist', 'IT leadership', 'Customer Success',
];
const allKeywords = [...new Set([...baseKeywords, ...keywords])].join(', ');

// Structured data graph: Person + Organization + WebSite (helps rich results)
const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.founder,
      url: site.url,
      image: new URL('/website/images/headshot.jpg', site.url).href,
      jobTitle: 'Technical Project Manager & Founder',
      worksFor: { '@id': `${site.url}/#org` },
      address: { '@type': 'PostalAddress', addressLocality: 'Seattle', addressRegion: 'WA', addressCountry: 'US' },
      knowsLanguage: ['English', 'Punjabi', 'Hindi', 'Urdu'],
      knowsAbout: ['AI', 'NLP', 'OCR', 'Cloud Infrastructure', 'Jamf Pro', 'Microsoft Intune', 'JumpCloud', 'NIST CSF', 'HIPAA', 'Technical Project Management', 'Technical Program Management', 'Customer Success', 'Systems Administration'],
      hasOccupation: site.roles.map((r) => ({ '@type': 'Occupation', name: r })),
      seeks: site.roles.map((r) => ({ '@type': 'Demand', name: `${r} role` })),
      sameAs: [site.socials.linkedin, site.socials.github, site.socials.huggingface],
      email: `mailto:${site.email}`,
    },
    {
      '@type': 'ProfilePage',
      '@id': `${site.url}/#profilepage`,
      url: site.url,
      name: `${site.founder} — ${site.brand}`,
      mainEntity: { '@id': `${site.url}/#person` },
      isPartOf: { '@id': `${site.url}/#website` },
    },
    {
      '@type': 'Organization',
      '@id': `${site.url}/#org`,
      name: site.brand,
      url: site.url,
      slogan: site.tagline,
      description: site.description,
      logo: new URL('/website/favicon.svg', site.url).href,
      founder: { '@id': `${site.url}/#person` },
      sameAs: [site.socials.linkedin, site.socials.github, site.socials.huggingface],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.brand,
      description: site.description,
      publisher: { '@id': `${site.url}/#org` },
      inLanguage: 'en',
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={allKeywords} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.founder} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#0a0d13" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.brand} — ${site.tagline}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${site.brand} — ${site.tagline}`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+Gurmukhi:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- No-JS fallback: never hide content if scripts don't run -->
    <noscript><style>.reveal{opacity:1 !important;transform:none !important;}</style></noscript>

    <!-- Favicon: Dosanjh Labs emblem -->
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/favicon.svg')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />
  </head>
  <body>
    <div class="bg-aurora"></div>
    <ConstellationBg />
    <div class="bg-grain"></div>

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-kesari-500 focus:text-ink-950 focus:px-4 focus:py-2 focus:rounded-lg">Skip to content</a>

    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-reveal via IntersectionObserver
      const reveals = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        reveals.forEach((el, i) => {
          (el as HTMLElement).style.transitionDelay = `${(i % 6) * 70}ms`;
          io.observe(el);
        });
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
